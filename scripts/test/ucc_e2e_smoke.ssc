---
name: ucc-e2e-smoke
version: 1.0.0
---

# UCC acceptance e2e smoke test (headless, mocked Face ID)

ScalaScript (`.ssc`) port of `ucc_e2e_smoke.py`, run on the JVM backend
(`ssc run-jvm`) so the standard-`scala` fence has the full Java stdlib for the
system bits (HTTP client, subprocess, file I/O) that the interpreter-only
`std/process` + `std/fs` externs don't provide together on one backend.

Headless + MOCKED — no browser, no Face ID hardware. Spins up an ISOLATED
`control-serve` (temp `XDG_STATE_HOME`, `rp_id=localhost`) so it never touches the
operator's real credentials/sessions, smoke-tests the unauthenticated surface +
WebAuthn (Face ID) wiring, then MOCKS the Face ID login by injecting the session a
real login would mint and verifies the authenticated surface.

Run: `../scalascript/bin/ssc run-jvm scripts/test/ucc_e2e_smoke.ssc`  — non-zero exit on any failure.

```scala
import java.net.URI
import java.net.http.{HttpClient, HttpRequest}
import java.net.http.HttpRequest.BodyPublishers
import java.net.http.HttpResponse.BodyHandlers
import java.nio.file.{Files, Paths}
import java.time.Duration

val bin =
  if Files.exists(Paths.get("target/release/rozum-gateway")) then "target/release/rozum-gateway"
  else sys.env("HOME") + "/.rozum/bin/rozum-gateway"

val port   = 18492
val base   = s"http://127.0.0.1:$port"
val origin = s"http://localhost:$port"
val state  = Files.createTempDirectory("ucc-e2e-").toString
val ucc    = state + "/rozum"            // state_dir() == $XDG_STATE_HOME/rozum

var passed = 0
var total  = 0
def check(name: String, ok: Boolean, detail: String = ""): Unit =
  total += 1
  if ok then { passed += 1; println(s"  PASS  $name") }
  else println(s"  FAIL  $name" + (if detail.nonEmpty then s"  -- $detail" else ""))

def hasField(body: String, field: String, value: String): Boolean =
  body.contains("\"" + field + "\":" + value)   // compact serde JSON, no spaces

val client = HttpClient.newBuilder().connectTimeout(Duration.ofSeconds(3)).build()

/** (status, body). status 0 == connection failed. */
def req(method: String, path: String, cookie: String = "", body: String = ""): (Int, String) =
  var b = HttpRequest.newBuilder(URI.create(base + path)).timeout(Duration.ofSeconds(8))
  if cookie.nonEmpty then b = b.header("Cookie", cookie)
  b =
    if body.nonEmpty then b.header("Content-Type", "application/json").method(method, BodyPublishers.ofString(body))
    else b.method(method, BodyPublishers.noBody())
  try
    val r = client.send(b.build(), BodyHandlers.ofString())
    (r.statusCode(), r.body())
  catch case _: Throwable => (0, "")

def write(name: String, contents: String): Unit =
  Files.write(Paths.get(ucc, name), contents.getBytes("UTF-8"))

// ---- start an ISOLATED control-serve ----
val pb = ProcessBuilder(bin, "gateway", "control-serve", "--port", port.toString)
pb.environment().put("XDG_STATE_HOME", state)
pb.environment().put("ROZUM_UCC_RP_ID", "localhost")
pb.environment().put("ROZUM_UCC_ORIGIN", origin)
pb.redirectOutput(ProcessBuilder.Redirect.DISCARD)
pb.redirectError(ProcessBuilder.Redirect.DISCARD)
val proc = pb.start()

try
  println(s"== UCC acceptance e2e  (isolated :$port)  ==")

  // health: poll until listening
  var up = false
  var tries = 0
  while !up && tries < 30 do
    if req("GET", "/")._1 == 200 then up = true else { Thread.sleep(1000); tries += 1 }
  check("control-serve comes up", up, s"not up after $tries s")

  println("\n[Tier 1] unauthenticated surface + Face ID wiring")
  for pg <- List("/", "/login.html", "/terminal.html", "/admin.html", "/matrix.html") do
    val (s, _) = req("GET", pg)
    check(s"PWA serves $pg", s == 200, s"HTTP $s")

  check("gated /control/status -> 401 unauth", req("GET", "/control/status")._1 == 401)
  check("gated terminal attach -> 401 unauth", req("GET", "/control/session/attach/x")._1 == 401)

  val (asS, asB) = req("GET", "/control/auth/status")
  check("auth/status webauthn_ok=true", asS == 200 && hasField(asB, "webauthn_ok", "true"), asB)

  check("register/begin without token -> 403", req("POST", "/control/auth/register/begin", body = "{}")._1 == 403)

  val bootPath = Paths.get(ucc, "ucc-bootstrap-token.txt")
  val boot = if Files.exists(bootPath) then Files.readString(bootPath).trim else ""
  check("bootstrap token issued for first registration", boot.nonEmpty, "no token")

  val (rbS, rbB) = req("POST", "/control/auth/register/begin", body = s"""{"invite":"$boot","display_name":"e2e"}""")
  check("register/begin issues a valid passkey challenge (rp.id, challenge)",
    rbS == 200 && rbB.contains("\"challenge\"") && rbB.contains("localhost"), s"HTTP $rbS")

  check("login/begin with no enrolled passkey -> 400", req("POST", "/control/auth/login/begin", body = "")._1 == 400)

  // ---- Tier 2: MOCK Face ID by injecting the session a real login would mint ----
  println("\n[Tier 2] mocked Face ID auth (injected session)")
  write("ucc-roles.json",
    """[{"id":"readonly","name":"Read only","permissions":["read"]},{"id":"admin","name":"Administrator","permissions":["admin"]}]""")
  write("ucc-users.json",
    """[{"id":"e2e-mock","display_name":"E2E","role_ids":["admin"],"passkey_ids":[],"created_at":1,"created_by":null}]""")
  val tok = "e2e-mock-session-000000000000000000000000"
  write("ucc-auth-sessions.json", s"""[{"token":"$tok","user_id":"e2e-mock","expires_at":9999999999}]""")
  val ck = s"rozum_sess=$tok"

  check("valid session -> /control/status 200 (gate opens)", req("GET", "/control/status", cookie = ck)._1 == 200)
  val (as2S, as2B) = req("GET", "/control/auth/status", cookie = ck)
  check("valid session -> auth/status authed=true", as2S == 200 && hasField(as2B, "authed", "true"), as2B)

  write("ucc-auth-sessions.json", s"""[{"token":"$tok","user_id":"e2e-mock","expires_at":1}]""")
  check("EXPIRED session -> 401 (expiry enforced)", req("GET", "/control/status", cookie = ck)._1 == 401)
  check("bogus session token -> 401", req("GET", "/control/status", cookie = "rozum_sess=nope")._1 == 401)

finally
  proc.destroy()
  try { import scala.sys.process.*; Seq("rm", "-rf", state).! } catch case _: Throwable => ()

println(s"\n== $passed/$total checks passed ==")
sys.exit(if passed == total then 0 else 1)
```
