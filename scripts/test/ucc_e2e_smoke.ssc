---
name: ucc-e2e-smoke
version: 1.0.0
---

# UCC acceptance e2e smoke test (headless, mocked Face ID)

Native ScalaScript (`.ssc`) acceptance test for the UCC control-center PWA, run on the
v2 VM with the std `http` / `process` / `fs` primitives:

    ../scalascript/bin/ssc run scripts/test/ucc_e2e_smoke.ssc

Headless + MOCKED — no browser, no Face ID hardware. Spins up an ISOLATED `control-serve`
(temp `XDG_STATE_HOME`, `rp_id=localhost`) so it never touches the operator's real
credentials/sessions, smoke-tests the unauthenticated surface + WebAuthn (Face ID)
wiring, then MOCKS the Face ID login by injecting the session a real login would mint and
verifies the authenticated surface. Non-zero exit on any failed check.

[exec, ProcessOptions](std/process.ssc)
[readFile, writeFile, exists, mkdirs](std/fs.ssc)
[httpGet, httpPost, httpTimeout, httpRetry](std/http.ssc)

```scalascript
val bin =
  if exists("target/release/rozum-gateway") then "target/release/rozum-gateway"
  else exec("bash", List("-c", "printf %s \"$HOME\""), ProcessOptions()).stdout + "/.rozum/bin/rozum-gateway"

val port   = 18492
val base   = s"http://127.0.0.1:$port"
val origin = s"http://localhost:$port"
val state  = "/tmp/ucc-e2e-ssc-state"
val ucc    = s"$state/rozum"                 // state_dir() == $XDG_STATE_HOME/rozum

var passed = 0
var total  = 0
def check(name: String, ok: Boolean, detail: String): Unit =
  total = total + 1
  if ok then
    passed = passed + 1
    println(s"  PASS  $name")
  else
    println(s"  FAIL  $name  -- $detail")

// Smoke-level JSON assertion by substring (compact serde JSON, no spaces).
def hasField(body: String, field: String, value: String): Boolean =
  body.contains("\"" + field + "\":" + value)

// Clean + start an ISOLATED control-serve in the background (env inline so it inherits the
// full parent env + our overrides; `echo $$!` returns the detached PID).
exec("rm", List("-rf", state), ProcessOptions())
val spawn =
  s"XDG_STATE_HOME='$state' ROZUM_UCC_RP_ID=localhost ROZUM_UCC_ORIGIN='$origin' " +
  s"nohup '$bin' gateway control-serve --port $port >/dev/null 2>&1 & echo $$!"
val pid = exec("bash", List("-c", spawn), ProcessOptions()).stdout.trim()

println(s"== UCC acceptance e2e  (isolated :$port)  ==")

// Health: httpRetry makes httpGet retry a refused connection until the server is listening
// (httpRetry/httpTimeout bind on the v2 VM; the curried httpClient{} does not, so no block here).
httpTimeout(3000)
httpRetry(30, 1000)
val up = httpGet(base + "/").status == 200
check("control-serve comes up", up, "not up")

println("")
println("[Tier 1] unauthenticated surface + Face ID wiring")
for pg <- List("/", "/login.html", "/terminal.html", "/admin.html", "/matrix.html") do
  val r = httpGet(base + pg)
  check(s"PWA serves $pg", r.status == 200, s"HTTP ${r.status}")

check("gated /control/status -> 401 unauth", httpGet(base + "/control/status").status == 401, "")
check("gated terminal attach -> 401 unauth", httpGet(base + "/control/session/attach/x").status == 401, "")

val as1 = httpGet(base + "/control/auth/status")
check("auth/status webauthn_ok=true", as1.status == 200 && hasField(as1.body, "webauthn_ok", "true"), as1.body)

check("register/begin without token -> 403",
  httpPost(base + "/control/auth/register/begin", "{}").status == 403, "")

val boot = if exists(s"$ucc/ucc-bootstrap-token.txt") then readFile(s"$ucc/ucc-bootstrap-token.txt").trim() else ""
check("bootstrap token issued for first registration", boot != "", "no token")

val rb = httpPost(base + "/control/auth/register/begin",
  s"""{"invite":"$boot","display_name":"e2e"}""", Map("Content-Type" -> "application/json"))
check("register/begin issues a valid passkey challenge (rp.id, challenge)",
  rb.status == 200 && rb.body.contains("\"challenge\"") && rb.body.contains("localhost"), s"HTTP ${rb.status}")

check("login/begin with no enrolled passkey -> 400",
  httpPost(base + "/control/auth/login/begin", "").status == 400, "")

println("")
println("[Tier 2] mocked Face ID auth (injected session)")
mkdirs(ucc)
writeFile(s"$ucc/ucc-roles.json",
  """[{"id":"readonly","name":"Read only","permissions":["read"]},{"id":"admin","name":"Administrator","permissions":["admin"]}]""")
writeFile(s"$ucc/ucc-users.json",
  """[{"id":"e2e-mock","display_name":"E2E","role_ids":["admin"],"passkey_ids":[],"created_at":1,"created_by":null}]""")
val tok = "e2e-mock-session-000000000000000000000000"
writeFile(s"$ucc/ucc-auth-sessions.json",
  s"""[{"token":"$tok","user_id":"e2e-mock","expires_at":9999999999}]""")
val ck = Map("Cookie" -> s"rozum_sess=$tok")

check("valid session -> /control/status 200 (gate opens)",
  httpGet(base + "/control/status", ck).status == 200, "")
val as2 = httpGet(base + "/control/auth/status", ck)
check("valid session -> auth/status authed=true", as2.status == 200 && hasField(as2.body, "authed", "true"), as2.body)

writeFile(s"$ucc/ucc-auth-sessions.json",
  s"""[{"token":"$tok","user_id":"e2e-mock","expires_at":1}]""")
check("EXPIRED session -> 401 (expiry enforced)",
  httpGet(base + "/control/status", ck).status == 401, "")
check("bogus session token -> 401",
  httpGet(base + "/control/status", Map("Cookie" -> "rozum_sess=nope")).status == 401, "")

// Teardown
exec("kill", List(pid), ProcessOptions())
exec("rm", List("-rf", state), ProcessOptions())

println("")
println(s"== $passed/$total checks passed ==")
sys.exit(if passed == total then 0 else 1)
```
