## Page
```scalascript
val DEF_MODEL   = "mlx-community:Qwen3.5-4B-MLX-4bit"
val DEF_PROJECT = "/Users/sergiy/work/my/rozum"

// ── Reactive state (all toolkit signals) ────────────────────────────────────
val mode      = persistedSignal("rozum_chat_mode",    "chat")
val agent     = persistedSignal("rozum_chat_agent",   "claude")
val model     = persistedSignal("rozum_chat_model",   DEF_MODEL)
val project   = persistedSignal("rozum_chat_project", DEF_PROJECT)
val ready     = persistedSignal("rozum_chat_ready",   "0")
val turns     = persistedSignal("rozum_chat_msgs",    "[]")
val draft     = signal("draft",     "")
val streaming = signal("streaming", "0")
val sendTick  = signal("sendTick",  0)
// The single in-flight answer, as a 0-or-1-element JSON array the fence rewrites as tokens
// arrive (kept SEPARATE from the committed `turns` so a token never re-parses the whole thread).
val liveJson  = signal("liveJson",  "[]")

// Config-vs-chat switch + agent-only block, as truthy String signals for showWhen.
val readyBool = computedSignal(() => if ready() == "1" then "1" else "")
val agentBool = computedSignal(() => if mode() == "agent" then "1" else "")

// ── i18n catalog (reactive; base = English) ─────────────────────────────────
val CAT = Map(
  "ru" -> Map(
    "Companion" -> "Собеседник", "Agent" -> "Агент", "Mode" -> "Режим",
    "Model" -> "Модель", "Project" -> "Проект", "Start chatting" -> "Начать",
    "Say something to your model." -> "Напиши что-нибудь своей модели.",
    "Ask the agent to do something in the project." -> "Попроси агента что-нибудь сделать в проекте.",
    "Companion talks to the model directly; Agent runs a coding agent in a project." ->
      "«Собеседник» говорит с моделью напрямую; «Агент» запускает кодинг-агента в проекте."),
  "uk" -> Map(
    "Companion" -> "Співрозмовник", "Agent" -> "Агент", "Mode" -> "Режим",
    "Model" -> "Модель", "Project" -> "Проєкт", "Start chatting" -> "Почати",
    "Say something to your model." -> "Напиши щось своїй моделі.",
    "Ask the agent to do something in the project." -> "Попроси агента щось зробити в проєкті.",
    "Companion talks to the model directly; Agent runs a coding agent in a project." ->
      "«Співрозмовник» говорить з моделлю напряму; «Агент» запускає кодинг-агента в проєкті."))

def tr(key: String): String = translateIn(CAT, localeSignal(), key, key)

// ── Streaming transport (toolkit): computed body → fetchStreamSignal ─────────
// body is a computedSignal so it is bridge-tracked (its _sv value tracks the live turns).
// GUARD: fetchStreamSignal fires its POST once at MOUNT (unconditionally). With the live
// conversation in the body that would auto-run an inference on every page load of a saved
// chat. So we only put the messages in the body while a send is in flight (streaming == "1");
// at rest the body carries empty messages, so the mount fire is a harmless no-op 400.
val body = computedSignal(() => {
  val msgs =
    if streaming() != "1" then ""
    else jsonValue(turns()).asList.map(m => {
      val role = if m.get("role").asString == "user" then "user" else "assistant"
      "{\"role\":\"" + role + "\",\"content\":" + jStr(m.get("text").asString) + "}"
    }).mkString(",")
  "{\"model\":" + jStr(model()) + ",\"messages\":[" + msgs + "]}"
})
val streamRaw = fetchStreamSignal("streamRaw", "/control/chat/stream", body, sendTick)

// ── Status polling (toolkit): intervalTick + fetchUrlSignal ─────────────────
val statusTick = intervalTick("statusTick", 5000)
val statusSig  = fetchUrlSignal("status", "/control/status", statusTick)
// The config pickers read a ONE-TIME status snapshot (cfgTick never bumps → fetch only at mount),
// NOT the 5 s poll: a poll re-render was re-drawing the picker tables and wiping the row-selection ✓
// a second after tapping "select" (the model value persisted in the signal, only the visual reset).
// Installed models + projects don't change mid-config, so a single snapshot is the right grain here.
val cfgTick = signal("cfgTick", 0)
val cfgSig  = fetchUrlSignal("cfgStatus", "/control/status", cfgTick)

// Hidden anchor: keeps the fence-only signals from being tree-shaken AND collects them (incl. the
// computed `body`, whose bridge `_sv` value must track the live turns) into the mounted signal set.
val sink = computedSignal(() => {
  val _a = streamRaw(); val _b = streaming(); val _c = draft(); val _d = sendTick(); val _e = body()
  val _f = liveJson()
  ""
})

// ── Config screen (toolkit widgets, center.ssc-style) ───────────────────────
val companionLbl = computedSignal(() => (if mode()  == "chat"  then "✓ " else "") + "💬 " + tr("Companion"))
val agentModeLbl  = computedSignal(() => (if mode()  == "agent" then "✓ " else "") + "🤖 " + tr("Agent"))
val claudeLbl     = computedSignal(() => (if agent() == "claude"   then "✓ " else "") + "claude")
val codexLbl      = computedSignal(() => (if agent() == "codex"    then "✓ " else "") + "codex")
val opencodeLbl   = computedSignal(() => (if agent() == "opencode" then "✓ " else "") + "opencode")
val startLbl      = computedSignal(() => "▶ " + tr("Start chatting"))
val modeLbl       = computedSignal(() => tr("Mode"))
val modelLbl      = computedSignal(() => tr("Model"))
val agentLbl      = computedSignal(() => tr("Agent"))
val projectLbl    = computedSignal(() => tr("Project"))

val modelPicker = remoteTable(cfgSig, [fieldColumn("Model", "spec")], "installed",
  [rowLink("select", model, "spec")], "spec")
val projectPicker = remoteTable(cfgSig, [fieldColumn("Project", "name")], "projects",
  [rowLink("select", project, "path")], "path")

val agentBlock = vstack(gap = 12)(
  vstack(gap = 6)(signalText_(agentLbl),
    hstack(gap = 8)(
      signalLabelButton(agent, "claude",   claudeLbl),
      signalLabelButton(agent, "codex",    codexLbl),
      signalLabelButton(agent, "opencode", opencodeLbl))),
  vstack(gap = 6)(signalText_(projectLbl), projectPicker))

val configScreen = vstack(gap = 16)(
  rawHtml("<div class='cfg-hd'></div>"),
  heading(2, "rozum · chat"),
  localeText(CAT, "Companion talks to the model directly; Agent runs a coding agent in a project.",
                  "Companion talks to the model directly; Agent runs a coding agent in a project."),
  vstack(gap = 6)(signalText_(modeLbl),
    hstack(gap = 8)(
      signalLabelButton(mode, "chat",  companionLbl),
      signalLabelButton(mode, "agent", agentModeLbl))),
  vstack(gap = 6)(signalText_(modelLbl), modelPicker),
  showWhen(agentBool, agentBlock, rawHtml("")),
  signalLabelButton(ready, "1", startLbl))

// ── Message thread (DECLARATIVE — the toolkit's forJson primitive) ──────────
// Three keyed lists share the same styled `.msg`/`.bubble`/`.who` CSS the fence used to
// hand-paint: the committed `turns`, the single in-flight `liveJson`, and a one-shot
// empty-state. `itemField` returns the RAW field value, so `esc` HTML-escapes it before it
// is spliced into rawHtml (the fence no longer touches the thread DOM).
// NB: use `.replace` (literal, all-occurrences → JS replaceAll) not `.replaceAll` (regex; the
// toolkit's JS dispatch has no case for it → a swallowed "Method not found" would blank the row).
def esc(s: String): String =
  s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")

// A committed bubble from a parsed {id, role, text, who, mono} item.
def bubbleNode(m: Any): TkNode =
  val role = if itemField(m, "role") == "user" then "user" else "bot"
  val mono = if role == "bot" && itemField(m, "mono") == "1" then " mono" else ""
  val who  = if role == "bot" then "<div class='who'>" + esc(itemField(m, "who")) + "</div>" else ""
  rawHtml("<div class='msg " + role + "'>" + who +
          "<div class='bubble" + mono + "'>" + esc(itemField(m, "text")) + "</div></div>")

// The in-flight bubble: a growing answer (with a blinking cursor) or a phase placeholder.
def liveNode(m: Any): TkNode =
  val text  = itemField(m, "text")
  val mono  = if text != "" && itemField(m, "mono") == "1" then " mono" else ""
  val inner = if text != "" then esc(text) + "<span class='cur'></span>"
              else "<span class='phase'>" + esc(itemField(m, "phase")) + "</span><span class='cur'></span>"
  rawHtml("<div class='msg bot'><div class='who'>" + esc(itemField(m, "who")) + "</div>" +
          "<div class='bubble" + mono + "'>" + inner + "</div></div>")

// The empty-state hint (0 or 1 element), reactive to mode + locale.
def emptyNode(m: Any): TkNode =
  rawHtml("<div class='empty'><div class='big'>" + itemField(m, "emoji") + "</div><div>" +
          esc(itemField(m, "hint")) + "</div></div>")

val emptyArr = computedSignal(() => {
  val hasMsgs = turns()    != "[]" && turns()    != ""
  val hasLive = liveJson() != "[]" && liveJson() != ""
  if hasMsgs || hasLive then "[]"
  else {
    val agentMode = mode() == "agent"
    val emoji = if agentMode then "🤖" else "💬"
    val hint  = if agentMode then tr("Ask the agent to do something in the project.")
                else tr("Say something to your model.")
    "[{\"id\":\"empty\",\"emoji\":" + jStr(emoji) + ",\"hint\":" + jStr(hint) + "}]"
  }
})

// The scrollable thread region (its `#thread` box CSS is targeted via the forJson container).
val threadArea = vstack(gap = 12)(
  forJson(emptyArr, "id")((m: Any) => emptyNode(m)),
  forJson(turns,    "id")((m: Any) => bubbleNode(m)),
  forJson(liveJson, "id")((m: Any) => liveNode(m)))

// ── Chat screen (sysbar + composer stay fence-painted; thread is forJson) ────
val chatScreen = vstack(gap = 0)(
  rawHtml("<div id='sysbar'></div>"),
  threadArea,
  rawHtml("<div id='composer'><textarea id='inp' rows='1' autocomplete='off' " +
          "oninput='window.__chat&amp;&amp;window.__chat.draft(this)' " +
          "onkeydown='window.__chat&amp;&amp;window.__chat.keydown(event)'></textarea>" +
          "<button id='send' type='button' onclick='window.__chat&amp;&amp;window.__chat.send()'>send</button></div>"))

// ── Compose + serve ─────────────────────────────────────────────────────────
val view = vstack(gap = 0)(
  rawHtml("<div id='rozum-lang'>" +
    "<button class='rl-btn' data-lang='en' onclick=\"window.__chat&amp;&amp;window.__chat.lang('en')\">EN</button>" +
    "<button class='rl-btn' data-lang='ru' onclick=\"window.__chat&amp;&amp;window.__chat.lang('ru')\">RU</button>" +
    "<button class='rl-btn' data-lang='uk' onclick=\"window.__chat&amp;&amp;window.__chat.lang('uk')\">UK</button></div>"),
  rawHtml("<div id='bar'><a href='/'>← UCC</a><div class='meta' id='meta'></div>" +
          "<span class='ic' id='cfgbtn' onclick='window.__chat&amp;&amp;window.__chat.reset()'>⚙</span>" +
          "<span id='st'></span></div>"),
  showWhen(readyBool, chatScreen, configScreen),
  signalText_(sink))

val bodyCss = "html,body{margin:0;height:100%;background:radial-gradient(130% 95% at 50% 36%,transparent 50%,rgba(2,3,7,.62) 100%),radial-gradient(135% 85% at 50% -12%,#163a50 0%,#0b1d2c 32%,#06090f 68%,#05070c 100%),radial-gradient(58% 48% at 16% 6%,rgba(44,84,120,.34),transparent 62%),radial-gradient(52% 44% at 88% 20%,rgba(74,46,104,.26),transparent 60%) fixed;color:#e6e6e6;font:15px -apple-system,system-ui,sans-serif}"

val pageCss =
  ".ssc-page{max-width:640px;width:100%;margin:0 auto;padding:0;height:100dvh;display:flex;flex-direction:column;font:15px -apple-system,system-ui,sans-serif;color:#e6e6e6}" +
  ".ssc-page>div{min-height:0}" +
  "#bar{display:flex;gap:10px;align-items:center;padding:10px max(12px,env(safe-area-inset-right)) 10px max(12px,env(safe-area-inset-left));background:#151a23;border-bottom:1px solid #232a36;flex:0 0 auto}" +
  "#bar a,#bar .ic{color:#7ab8ff;text-decoration:none;cursor:pointer;font-size:15px;flex:0 0 auto}#bar .meta{min-width:0;line-height:1.15;flex:1 1 auto}#bar .meta b{display:block;font-size:13px;color:#e6edf6;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}#bar .meta small{font-size:11px;color:#8a93a0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;display:block}#st{font-size:12px;color:#8a93a0;flex:0 0 auto}" +
  "#sysbar{display:flex;gap:9px;align-items:center;flex-wrap:wrap;padding:5px max(12px,env(safe-area-inset-right)) 6px max(12px,env(safe-area-inset-left));background:#0d1219;border-bottom:1px solid #1c2330;font-size:11px;color:#8a93a0;flex:0 0 auto;line-height:1}" +
  "#sysbar .seg{display:flex;align-items:center;gap:4px;white-space:nowrap}#sysbar b{color:#c9d4e3;font-weight:600}" +
  "#sysbar .dot{width:7px;height:7px;border-radius:50%;flex:0 0 auto}#sysbar .warm{background:#2ea043;box-shadow:0 0 5px #2ea04388}#sysbar .sleep{background:#6e7681}" +
  "#sysbar .bar{width:46px;height:5px;border-radius:3px;background:#1c2330;overflow:hidden;flex:0 0 auto}#sysbar .bar>i{display:block;height:100%;background:linear-gradient(90deg,#2ea043,#e5a53b)}" +
  ".ssc-page div:has(>span[data-ssc-forjson]){flex:1 1 auto;overflow-y:auto;-webkit-overflow-scrolling:touch;padding:14px max(10px,env(safe-area-inset-right)) 10px max(10px,env(safe-area-inset-left));display:flex;flex-direction:column;gap:12px}" +
  ".msg{display:flex;flex-direction:column;gap:3px;max-width:100%}.msg .who{font-size:10.5px;color:#8a93a0;padding:0 3px}.bubble{padding:10px 13px;border-radius:15px;max-width:92%;overflow-wrap:anywhere;word-break:break-word}" +
  ".msg.user{align-items:flex-end}.msg.user .bubble{background:#1f6feb;color:#fff;border-bottom-right-radius:5px;white-space:pre-wrap}" +
  ".msg.bot{align-items:flex-start}.msg.bot .bubble{background:#10141c;border:1px solid #232a36;border-bottom-left-radius:5px;white-space:pre-wrap;font:13px/1.5 -apple-system,system-ui,sans-serif;color:#e2e8f2;max-width:100%}" +
  ".msg.bot .bubble.mono{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:12.5px;color:#d7dee8}" +
  ".phase{color:#e5a53b;font-style:italic}.cur::after{content:'▍';color:#56d364;animation:bl 1s steps(2) infinite}@keyframes bl{50%{opacity:0}}" +
  ".empty{color:#8a93a0;text-align:center;margin:16vh auto 0;max-width:300px;font-size:14px}.empty .big{font-size:38px;margin-bottom:8px}" +
  "#composer{display:flex;gap:8px;padding:8px max(10px,env(safe-area-inset-right)) max(8px,env(safe-area-inset-bottom)) max(10px,env(safe-area-inset-left));background:#10141c;border-top:1px solid #232a36;flex:0 0 auto}#inp{flex:1 1 auto;min-width:0;padding:11px 13px;background:#0b0e14;color:#e6e6e6;border:1px solid #2c3648;border-radius:11px;font-size:16px;font-family:-apple-system,system-ui,sans-serif;resize:none;max-height:38vh}#send{flex:0 0 auto;padding:0 17px;background:#1f3a28;color:#56d364;border:1px solid #2ea043;border-radius:11px;font-size:15px;font-weight:600;cursor:pointer}#send:active{background:#2a4d34}#send.busy{background:#3a2a1a;color:#e5a53b;border-color:#8a5a2a}"

val cfgCss =
  ".ssc-page[data-cfg] h2,.ssc-page h2{font-size:17px;margin:2px 0 2px;color:#e6edf6;font-weight:650}" +
  ".ssc-page{overflow-y:auto}" +
  ".cfg-hd{height:8px}"

val langCss = "#rozum-lang{position:fixed;top:9px;right:12px;display:flex;gap:1px;z-index:999}.rl-btn{background:#21262d;color:#6e7681;border:1px solid #30363d;padding:3px 7px;cursor:pointer;font-size:10px;font-weight:600;letter-spacing:.03em}.rl-btn:first-child{border-radius:5px 0 0 5px}.rl-btn:last-child{border-radius:0 5px 5px 0}.rl-btn.active{background:#1f3a28;border-color:#2ea043;color:#56d364}"

serve(lower(view, darkTheme), 8410, bodyCss + pageCss + cfgCss + langCss)
```

## Orchestration (imperative JS fence — reads/writes the toolkit signals)
```javascript
// NOTE (emit-spa): this block is spliced verbatim at module scope TWICE. So it defines only
// functions + one deferred setTimeout(boot); nothing at top level touches a toolkit const.
var _LT = {
  "ru": {"← UCC":"← UCC","rozum · chat":"rozum · чат","warm":"тёплая","sleeping":"спит","free":"своб.","m":"м","h":"ч",
    "message…":"сообщение…","send":"отпр.","working…":"работает…","loading model…":"гружу модель…","thinking…":"думаю…",
    "conversation":"диалог","Companion":"Собеседник","(no answer)":"(нет ответа)","⚠ launch failed":"⚠ не удалось запустить",
    "Ask the agent to do something in the project.":"Попроси агента что-нибудь сделать в проекте.",
    "Say something to your model.":"Напиши что-нибудь своей модели.","Clear this conversation and change settings?":"Очистить этот диалог и сменить настройки?"},
  "uk": {"← UCC":"← UCC","rozum · chat":"rozum · чат","warm":"тепла","sleeping":"спить","free":"вільно","m":"хв","h":"год",
    "message…":"повідомлення…","send":"надісл.","working…":"працює…","loading model…":"вантажу модель…","thinking…":"думаю…",
    "conversation":"діалог","Companion":"Співрозмовник","(no answer)":"(немає відповіді)","⚠ launch failed":"⚠ не вдалося запустити",
    "Ask the agent to do something in the project.":"Попроси агента щось зробити в проєкті.",
    "Say something to your model.":"Напиши щось своїй моделі.","Clear this conversation and change settings?":"Очистити цей діалог і змінити налаштування?"}};
function _lg(){ return localStorage.getItem('rozum_lang') || (navigator.language||'en').split('-')[0] || 'en'; }
function _lt(s){ var m = _LT[_lg()]; return (m && m[s]) || s; }
function _esc(s){ return String(s).replace(/[&<>]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;'}[c];}); }
function _gib(b){ return (Number(b||0)/1073741824).toFixed(1); }
function _shortModel(s){ s=String(s||''); var c=s.indexOf(':'); if(c>=0)s=s.slice(c+1); return s.replace(/-MLX.*$/i,'').replace(/-4bit$/i,'')||s; }
function _byId(id){ return document.getElementById(id); }

function _turns(){ try{ var a=JSON.parse(turns.get()); return (a&&a.length)?a:[]; }catch(e){ return []; } }
function _setTurns(a){ turns.set(JSON.stringify(a.slice(-40))); }

// ---- SSE parse (accumulated raw → concatenated delta.content) ----
function _parseSSE(raw){
  var out='';
  (raw||'').split('\n').forEach(function(line){
    line=line.replace(/\r$/,''); if(line.indexOf('data:')!==0) return;
    var d=line.slice(5).replace(/^\s+/,''); if(!d||d==='[DONE]') return;
    try{ var j=JSON.parse(d); var c=j.choices&&j.choices[0]; var t=c&&c.delta&&c.delta.content; if(t) out+=t; }catch(e){}
  });
  return out;
}

// ---- Agent-mode log cleaning (keep the answer after the launch banner) ----
var _DROP=[/^rozum launch:/,/^context window:/,/^\s*→ /,/^⚠ /,/Claude Code v/,/dangerously-load-development-channels/,/^\s*Channels are not/,/mcp-proxy/,/^Earlier in this conversation:/,/^(User|You): /,/^Request: /,/^\s*\[rozum launch exited/];
var _BOUND=[/claude\.ai connectors/,/→ sandboxed/,/dangerously-load-development-channels/];
function _cleanLog(t){ if(!t) return '';
  var lines=t.split('\n'), last=-1;
  for(var i=0;i<lines.length;i++){ if(_BOUND.some(function(re){return re.test(lines[i]);})) last=i; }
  var b=(last>=0?lines.slice(last+1):lines);
  return b.filter(function(l){return !_DROP.some(function(re){return re.test(l);});}).join('\n').replace(/^\s+|\s+$/g,'');
}
function _phaseOf(raw){ if(/→ running:/.test(raw)) return _lt('thinking…'); if(/starting shared gateway|loading|admission/i.test(raw)) return _lt('loading model…'); return _lt('working…'); }

// ---- Declarative thread glue: write the toolkit signals; forJson paints the DOM ----
// The fence no longer builds the thread DOM. It appends the just-sent user turn + finished
// answers to `turns` (persisted, keyed by id) and rewrites the single in-flight `liveJson`
// bubble as tokens arrive; a `hashchange` flushes those signals into the forJson reconcile.
var _uidN=0;
function _uid(){ _uidN++; return 't'+Date.now().toString(36)+'-'+_uidN; }
function _who(){ return mode.get()==='agent' ? agent.get() : _lt('Companion'); }
function _mono(){ return mode.get()==='agent' ? '1' : ''; }
function _scrollThread(){ try{ var s=document.querySelector('span[data-ssc-forjson]'); var el=s&&s.parentElement; if(el) el.scrollTop=el.scrollHeight; }catch(e){} }

// In-flight bubble as a 0-or-1-element array. A new id only when the content changes → forJson
// re-creates the row exactly on new tokens and keeps it otherwise (no whole-thread reparse).
var _liveN=0, _liveSig=null;
function _setLive(text, phase){
  var t=text||'', ph=t?'':(phase||'');
  var sg=t+''+ph; if(sg===_liveSig) return; _liveSig=sg; _liveN++;
  liveJson.set(JSON.stringify([{id:'l'+_liveN, role:'bot', text:t, phase:ph, who:_who(), mono:_mono()}]));
  window.dispatchEvent(new Event('hashchange')); _scrollThread();
}
function _clearLive(){ _liveSig=null; if(liveJson.get()!=='[]'){ liveJson.set('[]'); window.dispatchEvent(new Event('hashchange')); } }

// Commit a finished bot answer into the persisted `turns`; clear the in-flight bubble.
function _commit(text){
  var arr=_turns(); arr.push({id:_uid(), role:'bot', text:text, who:_who(), mono:_mono()}); _setTurns(arr);
  _clearLive(); window.dispatchEvent(new Event('hashchange')); _scrollThread();
}

// ---- Sysbar: format the reactive /control/status (polled by fetchUrlSignal+intervalTick) ----
function _renderSysbar(){
  var el=_byId('sysbar'); if(!el) return;
  var d={}; try{ d=JSON.parse(statusSig.get())||{}; }catch(e){}
  var g=d.gateway||{}, r=d.residency||{}, warm=!!g.healthy;
  var mdl=_shortModel(g.model||model.get());
  var up = g.uptime_secs ? (g.uptime_secs<3600 ? Math.floor(g.uptime_secs/60)+_lt('m') : Math.floor(g.uptime_secs/3600)+_lt('h')) : '';
  var used=r.committed_bytes, budget=r.host_budget_bytes, free=r.available_bytes;
  var pct = budget ? Math.min(100, Math.round(100*(used||0)/budget)) : 0;
  var cl = (typeof g.clients==='number' && g.clients>0) ? (' · '+g.clients+'👤') : '';
  el.innerHTML =
    '<span class="seg"><span class="dot '+(warm?'warm':'sleep')+'"></span><b>'+_esc(mdl)+'</b></span>'+
    '<span class="seg">'+(warm?(_lt('warm')+(up?' '+up:'')+cl):_lt('sleeping'))+'</span>'+
    '<span class="seg">💾 <span class="bar"><i style="width:'+pct+'%"></i></span> <b>'+_gib(used)+'</b>/'+_gib(budget)+' GiB</span>'+
    '<span class="seg">'+_gib(free)+' '+_lt('free')+'</span>';
}

function _renderMeta(){
  var el=_byId('meta'); if(!el) return;
  var who = mode.get()==='agent' ? ('🤖 '+_esc(agent.get())) : ('💬 '+_esc(_lt('Companion')));
  var sub = mode.get()==='agent' ? _esc(String(project.get()).split('/').pop()) : _esc(_lt('conversation'));
  el.innerHTML='<b>'+who+' · '+_esc(String(model.get()).split('/').pop())+'</b><small>'+sub+'</small>';
}

function _setBusy(b){
  streaming.set(b?'1':'0');
  var s=_byId('send'); if(s){ s.className=b?'busy':''; s.textContent=b?_lt('working…'):_lt('send'); }
  var inp=_byId('inp'); if(inp) inp.placeholder=_lt('message…');
}

// ---- Composer input ----
function _onDraft(el){ draft.set(el.value); el.style.height='auto'; el.style.height=Math.min(el.scrollHeight, window.innerHeight*0.38)+'px'; }
function _onKeydown(e){ if(e.key==='Enter' && !e.shiftKey){ e.preventDefault(); _send(); } }

// ---- Send ----
function _send(){
  if(streaming.get()==='1') return;
  var v=(draft.get()||'').trim(); if(!v) return;
  var arr=_turns(); arr.push({id:_uid(), role:'user', text:v}); _setTurns(arr);
  draft.set(''); var inp=_byId('inp'); if(inp){ inp.value=''; inp.style.height='auto'; }
  window.dispatchEvent(new Event('hashchange')); _scrollThread();   // paint the user bubble
  _setBusy(true);
  if(mode.get()==='agent'){ _setLive('', _lt('working…')); _sendAgent(v); }
  else { _sendChat(); }
}

// COMPANION: bump the fetchStreamSignal tick (2-phase so the computed body syncs into the bridge
// before doStream reads it), then watch streamRaw grow and commit on [DONE].
function _sendChat(){
  try{ streamRaw.set(''); }catch(e){}                     // drop the previous turn's accumulator (incl. its [DONE])
  _setLive('', _lt('thinking…'));
  window.dispatchEvent(new Event('hashchange'));          // phase 1: bridge the fresh body into _sv
  setTimeout(function(){
    sendTick.set((sendTick.get()|0)+1);
    window.dispatchEvent(new Event('hashchange'));         // phase 2: fire the stream's tick sub
  }, 0);
}

// COMPANION completion + live paint (driven by the shared watch loop).
function _tickChat(){
  var raw=streamRaw.get()||'';
  var live=_parseSSE(raw);
  _setLive(live, live?'':_lt('thinking…'));
  if(raw.indexOf('[DONE]')>=0){
    _commit(live || ('⚠ '+_lt('(no answer)')));
    _setBusy(false);
  }
}

// AGENT: launch a headless coder, poll its log (not a stream → a plain fetch loop is fine here).
function _post(url, b){ return fetch(url,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(b)}).then(function(r){ if(r.status===401){location.href='/login.html';throw 0;} return r.json(); }); }
function _get(url){ return fetch(url).then(function(r){ if(r.status===401){location.href='/login.html';throw 0;} return r.json(); }); }
var _AFRAME='You are an assistant working INSIDE this project (the current directory), with tools to list/read/edit files and run commands. Before you answer, quickly EXPLORE what is relevant — list the files, read the README/AGENTS and the files the request is about — THEN respond concretely and concisely, grounded in what you actually saw. If the request is a task, do it. Do not answer from assumptions.';
function _buildPrompt(v){
  var prior=_turns(); var pairs=[];
  for(var i=0;i<prior.length-1;i++){ var m=prior[i]; if(m.text){ pairs.push((m.role==='user'?'User: ':'You: ')+String(m.text).slice(0,400)); } }
  pairs=pairs.slice(-8);
  var parts=[_AFRAME];
  if(pairs.length) parts.push('Earlier in this conversation:\n'+pairs.join('\n'));
  parts.push('Request: '+v);
  return parts.join('\n\n');
}
function _sendAgent(v){
  _post('/control/coder/launch',{agent:agent.get(),model:model.get(),workdir:project.get(),prompt:_buildPrompt(v),verify:false})
    .then(function(j){ if(!j||!j.id){ _agentFail(); return; } _pollRun(j.id); })
    .catch(function(e){ if(e!==0) _agentFail(); });
}
function _agentFail(){ _commit('⚠ '+_lt('⚠ launch failed')); _setBusy(false); }
function _pollRun(id){
  var started=false, deadReads=0, prevRaw='', stable=0, ticks=0;
  var finish=function(txt){ if(txt!=null){ _commit(txt||('⚠ '+_lt('(no answer)'))); } else { _clearLive(); } _setBusy(false); };
  var step=function(){
    ticks++;
    _get('/control/coder/log?id='+encodeURIComponent(id)+'&tail=600')
      .then(function(j){
        var raw=j.log||'';
        if(/→ running:/.test(raw)) started=true;
        var body=_cleanLog(raw);
        _setLive(body, body?'':_phaseOf(raw));
        if(raw===prevRaw){ stable++; } else { stable=0; prevRaw=raw; }
        deadReads = (started && !j.alive) ? deadReads+1 : 0;
        if(deadReads>=2 || (body && stable>=8)){ finish(body); return; }
        if(ticks>=140){ finish(body || ('⚠ '+_lt('⚠ launch failed'))); return; }
        setTimeout(step, 1200);
      })
      .catch(function(e){ if(e!==0){ finish(_lt('(no answer)')); } });
  };
  setTimeout(step, 700);
}

// ---- Lang / reset ----
function _setLang(l){
  localStorage.setItem('rozum_lang', l);
  try{ localeSignal.set(l); }catch(e){}
  document.documentElement.lang=l;
  Array.prototype.forEach.call(document.querySelectorAll('#rozum-lang .rl-btn'), function(b){ b.classList.toggle('active', b.getAttribute('data-lang')===l); });
  _renderMeta(); _renderSysbar();
  window.dispatchEvent(new Event('hashchange'));   // re-localizes the empty-state hint (emptyArr recomputes)
}
function _reset(){
  if(!window.confirm(_lt('Clear this conversation and change settings?'))) return;
  _setTurns([]); _clearLive(); ready.set('0');
  window.dispatchEvent(new Event('hashchange'));
}

// ---- Shared watch loop: repaint sysbar, drive the in-flight companion turn ----
function _watch(){
  if(window.__chatWatching) return; window.__chatWatching=true;
  setInterval(function(){
    _renderSysbar();
    if(ready.get()==='1' && streaming.get()==='1' && mode.get()!=='agent') _tickChat();
  }, 250);
}

// ---- Boot (deferred so all toolkit consts + the mounted DOM exist) ----
function _chatBoot(){
  if(window.__chatBooted) return; window.__chatBooted=true;
  window.__chat = { send:_send, draft:_onDraft, keydown:_onKeydown, lang:_setLang, reset:_reset };
  var l=_lg(); document.documentElement.lang=l;
  try{ localeSignal.set(l); }catch(e){}
  Array.prototype.forEach.call(document.querySelectorAll('#rozum-lang .rl-btn'), function(b){ b.classList.toggle('active', b.getAttribute('data-lang')===l); });
  _renderMeta(); _renderSysbar();
  _setBusy(streaming.get()==='1');
  _watch();
  window.dispatchEvent(new Event('hashchange'));   // forJson paints the persisted turns
  setTimeout(_scrollThread, 0);
}
setTimeout(_chatBoot, 0);
```
