val langCss = "#rozum-lang{position:fixed;top:9px;right:12px;display:flex;gap:1px;z-index:999}.rl-btn{background:#21262d;color:#6e7681;border:1px solid #30363d;padding:3px 7px;cursor:pointer;font-size:10px;font-weight:600;letter-spacing:.03em}.rl-btn:first-child{border-radius:5px 0 0 5px}.rl-btn:last-child{border-radius:0 5px 5px 0}.rl-btn.active{background:#1f3a28;border-color:#2ea043;color:#56d364}"

val js = """
var _LG=localStorage.getItem('rozum_lang')||navigator.language.split('-')[0]||'en';
var _LT={'ru':{'← UCC':'← UCC','rozum · chat':'rozum · чат','Chat with your project':'Чат с твоим проектом','Pick an agent + project. Every message runs the agent on the local model, in that project.':'Выбери агента и проект. Каждое сообщение запускает агента на локальной модели в этом проекте.','Agent':'Агент','Model':'Модель','Project':'Проект','▶ Start chatting':'▶ Начать','message…':'сообщение…','send':'отпр.','working…':'работает…','loading model…':'гружу модель…','thinking…':'думаю…','Ask the agent to do something in the project.':'Попроси агента что-нибудь сделать в проекте.','⚠ launch failed':'⚠ не удалось запустить','(no answer)':'(нет ответа)','Companion':'Собеседник','Mode':'Режим','conversation':'диалог','Companion talks to the model directly; Agent runs a coding agent in a project.':'«Собеседник» говорит с моделью напрямую; «Агент» запускает кодинг-агента в проекте.','warm':'тёплая','sleeping':'спит','free':'своб.','m':'м','h':'ч'},'uk':{'← UCC':'← UCC','rozum · chat':'rozum · чат','Chat with your project':'Чат з твоїм проєктом','Pick an agent + project. Every message runs the agent on the local model, in that project.':'Обери агента і проєкт. Кожне повідомлення запускає агента на локальній моделі в цьому проєкті.','Agent':'Агент','Model':'Модель','Project':'Проєкт','▶ Start chatting':'▶ Почати','message…':'повідомлення…','send':'надісл.','working…':'працює…','loading model…':'вантажу модель…','thinking…':'думаю…','Ask the agent to do something in the project.':'Попроси агента щось зробити в проєкті.','⚠ launch failed':'⚠ не вдалося запустити','(no answer)':'(немає відповіді)','Companion':'Співрозмовник','Mode':'Режим','conversation':'діалог','Companion talks to the model directly; Agent runs a coding agent in a project.':'«Співрозмовник» говорить з моделлю напряму; «Агент» запускає кодинг-агента в проєкті.','warm':'тепла','sleeping':'спить','free':'вільно','m':'хв','h':'год'}};
function _lt(s){var m=_LT[_LG];return(m&&m[s])||s;}
document.documentElement.lang=_LG;
if(_LT[_LG]&&_LT[_LG]['rozum · chat'])document.title=_LT[_LG]['rozum · chat'];
(function(){var d=document.createElement('div');d.id='rozum-lang';['en','ru','uk'].forEach(function(l){var b=document.createElement('button');b.className='rl-btn';b.textContent=l.toUpperCase();b.dataset.lang=l;b.onclick=function(){localStorage.setItem('rozum_lang',l);location.reload();};if(l===_LG)b.classList.add('active');d.appendChild(b);});document.body.appendChild(d);})();

var DEF_MODEL='mlx-community:Qwen3.5-4B-MLX-4bit';
var DEF_PROJECT='/Users/sergiy/work/my/rozum';
var AGENTS=['claude','codex','opencode'];
var cfg={mode:localStorage.getItem('rozum_chat_mode')||'chat',agent:localStorage.getItem('rozum_chat_agent')||'claude',model:localStorage.getItem('rozum_chat_model')||DEF_MODEL,project:localStorage.getItem('rozum_chat_project')||DEF_PROJECT};
var configured=localStorage.getItem('rozum_chat_ready')==='1';
var msgs=loadMsgs();   // {role:'user'|'bot', text, phase?}
var busy=false;

var $=function(s){return document.getElementById(s);};
var startEl=$('start'), threadEl=$('thread'), compEl=$('composer'), stEl=$('st'), metaEl=$('meta'), inp=$('inp'), send=$('send');

function loadMsgs(){ try{var a=JSON.parse(localStorage.getItem('rozum_chat_msgs'));if(a&&a.length){a.forEach(function(m){m.streaming=false;});return a;}}catch(e){} return []; }
function saveMsgs(){ try{localStorage.setItem('rozum_chat_msgs',JSON.stringify(msgs.slice(-40)));}catch(e){} }

function on401(r){ if(r.status===401){ location.href='/login.html'; throw 0; } return r; }
function getJSON(u){ return fetch(u,{headers:{}}).then(on401).then(function(r){return r.json();}); }
function postJSON(u,b){ return fetch(u,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(b)}).then(on401).then(function(r){return r.json();}); }
function esc(s){return String(s).replace(/[&<>]/g,function(m){return{'&':'&amp;','<':'&lt;','>':'&gt;'}[m];});}

/* The agent's REAL answer begins AFTER the launch banner + the echoed prompt (the `→ running: claude
   -p <prompt>` line spills the multi-line prompt — FRAME, "Earlier in this conversation:", "User: …" —
   into the log; only its first line starts with `→ `, so the rest used to leak into the bubble). Find
   the LAST banner-boundary line and keep only what follows; then drop any stray banner lines. Falls
   back to a plain filter when no banner is present. */
var DROP=[/^rozum launch:/,/^context window:/,/^\s*→ /,/^⚠ /,/Claude Code v/,/dangerously-load-development-channels/,/^\s*Channels are not/,/^\s*▐|^\s*▝|^\s*▘|^\s*▎/,/mcp-proxy/,/^Earlier in this conversation:/,/^(User|You): /,/^Request: /,/^\s*\[rozum launch exited/];
var BOUNDARY=[/claude\.ai connectors/,/→ sandboxed/,/dangerously-load-development-channels/];
function cleanLog(t){ if(!t)return '';
  var lines=t.split('\n'), last=-1;
  for(var i=0;i<lines.length;i++){ if(BOUNDARY.some(function(re){return re.test(lines[i]);})) last=i; }
  var body=(last>=0?lines.slice(last+1):lines);
  return body.filter(function(l){return !DROP.some(function(re){return re.test(l);});}).join('\n').replace(/^\s+|\s+$/g,''); }
/* phase from the RAW log: gateway warming vs agent running */
function phaseOf(raw){ if(/→ running:/.test(raw))return _lt('thinking…'); if(/starting shared gateway|loading|admission/i.test(raw))return _lt('loading model…'); return _lt('working…'); }

/* ---------- start / config ---------- */
function renderStart(models,projects){
  var modeChips='<span class="chip'+(cfg.mode==='chat'?' on':'')+'" data-mode="chat">💬 '+_lt('Companion')+'</span>'+
                '<span class="chip'+(cfg.mode==='agent'?' on':'')+'" data-mode="agent">🤖 '+_lt('Agent')+'</span>';
  var agentChips=AGENTS.map(function(a){return '<span class="chip'+(cfg.agent===a?' on':'')+'" data-agent="'+a+'">'+a+'</span>';}).join('');
  var modelOpts=(models&&models.length?models:[{spec:DEF_MODEL}]).map(function(m){var s=m.spec||m.id||m;return '<option value="'+esc(s)+'"'+(s===cfg.model?' selected':'')+'>'+esc(String(s).split('/').pop())+'</option>';}).join('');
  var projOpts=(projects&&projects.length?projects:[{name:'rozum',path:DEF_PROJECT}]).map(function(p){var pa=p.path||p;return '<option value="'+esc(pa)+'"'+(pa===cfg.project?' selected':'')+'>'+esc(p.name||String(pa).split('/').pop())+'</option>';}).join('');
  startEl.innerHTML=
    '<h2>'+_lt('rozum · chat')+'</h2><div class="sub">'+_lt('Companion talks to the model directly; Agent runs a coding agent in a project.')+'</div>'+
    '<div class="grp"><div class="lbl">'+_lt('Mode')+'</div><div class="chips" id="modes">'+modeChips+'</div></div>'+
    '<div class="grp"><div class="lbl">'+_lt('Model')+'</div><select class="sel" id="mdl">'+modelOpts+'</select></div>'+
    '<div class="grp agentonly"><div class="lbl">'+_lt('Agent')+'</div><div class="chips" id="agents">'+agentChips+'</div></div>'+
    '<div class="grp agentonly"><div class="lbl">'+_lt('Project')+'</div><select class="sel" id="prj">'+projOpts+'</select></div>'+
    '<button id="go">'+_lt('▶ Start chatting')+'</button>';
  var applyMode=function(){ Array.prototype.forEach.call(document.querySelectorAll('.agentonly'),function(x){x.style.display=(cfg.mode==='agent'?'':'none');}); };
  applyMode();
  $('modes').onclick=function(e){var c=e.target.closest('[data-mode]');if(!c)return;cfg.mode=c.dataset.mode;Array.prototype.forEach.call($('modes').children,function(x){x.classList.toggle('on',x.dataset.mode===cfg.mode);});applyMode();};
  $('agents').onclick=function(e){var c=e.target.closest('[data-agent]');if(!c)return;cfg.agent=c.dataset.agent;Array.prototype.forEach.call($('agents').children,function(x){x.classList.toggle('on',x.dataset.agent===cfg.agent);});};
  $('mdl').onchange=function(e){cfg.model=e.target.value;};
  $('prj').onchange=function(e){cfg.project=e.target.value;};
  $('go').onclick=function(){
    localStorage.setItem('rozum_chat_mode',cfg.mode);localStorage.setItem('rozum_chat_agent',cfg.agent);localStorage.setItem('rozum_chat_model',cfg.model);
    localStorage.setItem('rozum_chat_project',cfg.project);localStorage.setItem('rozum_chat_ready','1');
    configured=true; showChat(); inp.focus();
  };
}
function boot(){ getJSON('/control/status').then(function(s){renderStart(s.installed||s.models||[],s.projects||[]);}).catch(function(e){if(e!==0)renderStart([],[]);}); }

/* ---------- system toolbar (model · state · memory), polled from /control/status ---------- */
function shortModel(s){ s=String(s||''); var c=s.indexOf(':'); if(c>=0)s=s.slice(c+1); return s.replace(/-MLX.*$/i,'').replace(/-4bit$/i,'')||s; }
function gib(b){ return (Number(b||0)/1073741824).toFixed(1); }
function refreshSys(){
  var el=$('sysbar'); if(!el)return;
  getJSON('/control/status').then(function(d){
    var g=d.gateway, r=d.residency||{}, warm=!!(g&&g.healthy);
    var model=shortModel((g&&g.model)||cfg.model);
    var up=(g&&g.uptime_secs)?(g.uptime_secs<3600?Math.floor(g.uptime_secs/60)+_lt('m'):Math.floor(g.uptime_secs/3600)+_lt('h')):'';
    var used=r.committed_bytes, budget=r.host_budget_bytes, free=r.available_bytes;
    var pct=(budget?Math.min(100,Math.round(100*(used||0)/budget)):0);
    var cl=(g&&typeof g.clients==='number'&&g.clients>0)?(' · '+g.clients+'👤'):'';
    el.innerHTML=
      '<span class="seg"><span class="dot '+(warm?'warm':'sleep')+'"></span><b>'+esc(model)+'</b></span>'+
      '<span class="seg">'+(warm?(_lt('warm')+(up?' '+up:'')+cl):_lt('sleeping'))+'</span>'+
      '<span class="seg">💾 <span class="bar"><i style="width:'+pct+'%"></i></span> <b>'+gib(used)+'</b>/'+gib(budget)+' GiB</span>'+
      '<span class="seg">'+gib(free)+' '+_lt('free')+'</span>';
  }).catch(function(){});
}

/* ---------- chat ---------- */
function setMeta(){ var who=cfg.mode==='agent'?('🤖 '+esc(cfg.agent)):('💬 '+_lt('Companion')); var sub=cfg.mode==='agent'?esc(String(cfg.project).split('/').pop()):_lt('conversation'); metaEl.innerHTML='<b>'+who+' · '+esc(String(cfg.model).split('/').pop())+'</b><small>'+sub+'</small>'; }
function showStart(){ startEl.classList.remove('hidden'); threadEl.classList.add('hidden'); compEl.classList.add('hidden'); metaEl.innerHTML=''; boot(); }
function showChat(){ startEl.classList.add('hidden'); threadEl.classList.remove('hidden'); compEl.classList.remove('hidden'); setMeta(); inp.placeholder=_lt('message…'); send.textContent=_lt('send'); renderThread(); }
function renderThread(){
  if(!msgs.length){ threadEl.innerHTML='<div class="empty"><div class="big">🤖</div><div>'+_lt('Ask the agent to do something in the project.')+'</div></div>'; return; }
  threadEl.innerHTML=msgs.map(function(m){
    if(m.role==='user') return '<div class="msg user"><div class="bubble">'+esc(m.text)+'</div></div>';
    var inner;
    if(m.text){ inner=esc(m.text)+(m.streaming?'<span class="cur"></span>':''); }
    else if(m.streaming){ inner='<span class="phase">'+esc(m.phase||_lt('working…'))+'</span><span class="cur"></span>'; }
    else { inner='<span style="color:#6b7280">'+_lt('(no answer)')+'</span>'; }
    return '<div class="msg bot"><div class="who">'+esc(cfg.agent)+'</div><div class="bubble'+(m.text?' mono':'')+'">'+inner+'</div></div>';
  }).join('');
  threadEl.scrollTop=threadEl.scrollHeight;
}
function setBusy(b){ busy=b; send.classList.toggle('busy',b); send.textContent=b?_lt('working…'):_lt('send'); }

/* Drive the agent the way the matrix does: an EXPLORE-then-answer frame so the model looks at the
   project before replying (proven: greedy + this frame makes the 4B read the repo and summarise it
   accurately) + a compact history for context. Kept short — a 4B follows a crisp instruction, but a
   heavy system-prompt blob degrades it (the codex-lean lesson). */
var FRAME='You are an assistant working INSIDE this project (the current directory), with tools to list/read/edit files and run commands. Before you answer, quickly EXPLORE what is relevant — list the files, read the README/AGENTS and the files the request is about — THEN respond concretely and concisely, grounded in what you actually saw. If the request is a task, do it. Do not answer from assumptions.';
function buildPrompt(v){
  var prior=msgs.filter(function(m){return m.text;});   // exclude the just-added empty bot placeholder
  var pairs=[]; for(var i=0;i<prior.length;i++){ var m=prior[i]; if(m.role==='user')pairs.push('User: '+m.text); else pairs.push('You: '+m.text.slice(0,400)); }
  pairs=pairs.slice(-8);   // ~4 exchanges
  var parts=[FRAME];
  if(pairs.length) parts.push('Earlier in this conversation:\n'+pairs.join('\n'));
  parts.push('Request: '+v);
  return parts.join('\n\n');
}

function doSend(){
  var v=inp.value.trim(); if(!v||busy)return;
  msgs.push({role:'user',text:v});
  var bot={role:'bot',text:'',phase:_lt('working…'),streaming:true}; msgs.push(bot);
  inp.value=''; inp.style.height='auto'; renderThread(); saveMsgs(); setBusy(true);
  if(cfg.mode==='agent'){ sendAgent(v,bot); } else { sendChat(bot); }
}
/* AGENT mode: run a headless coding agent (claude/codex/opencode) in the project — it can explore,
   edit files, run commands. Slow + can hang on a weak model, so it is opt-in. */
function sendAgent(v,bot){
  var prompt=buildPrompt(v);
  postJSON('/control/coder/launch',{agent:cfg.agent,model:cfg.model,workdir:cfg.project,prompt:prompt,verify:false})
    .then(function(j){
      if(!j||!j.id){ bot.streaming=false; bot.text='⚠ '+_lt('⚠ launch failed'); setBusy(false); renderThread(); saveMsgs(); return; }
      pollRun(j.id,bot);
    })
    .catch(function(e){ if(e!==0){ bot.streaming=false; bot.text='⚠ '+_lt('⚠ launch failed'); setBusy(false); renderThread(); saveMsgs(); } });
}
/* COMPANION mode (default): talk to the resident model DIRECTLY over a streamed
   /control/chat/stream (OpenAI SSE piped from the gateway). Token-by-token, instant, never hangs —
   no agent, no repo exploration. Builds the real multi-turn message array from the visible history. */
function sendChat(bot){
  var conv=[], prior=msgs.slice(0,-1);   // all except the just-pushed empty bot placeholder
  for(var i=0;i<prior.length;i++){ var m=prior[i]; if(m.role==='user')conv.push({role:'user',content:m.text}); else if(m.text)conv.push({role:'assistant',content:m.text}); }
  conv=conv.slice(-16);
  bot.phase=_lt('thinking…'); renderThread();
  fetch('/control/chat/stream',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({model:cfg.model,messages:conv})})
    .then(on401)
    .then(function(r){
      if(!r.ok||!r.body){ bot.streaming=false; bot.text='⚠ '+_lt('⚠ launch failed'); setBusy(false); renderThread(); saveMsgs(); return; }
      var reader=r.body.getReader(), dec=new TextDecoder(), buf='';
      var done=function(){ bot.streaming=false; setBusy(false); renderThread(); saveMsgs(); };
      var pump=function(){
        reader.read().then(function(res){
          if(res.done){ done(); return; }
          buf+=dec.decode(res.value,{stream:true});
          var parts=buf.split('\n'); buf=parts.pop();
          parts.forEach(function(line){
            line=line.replace(/\r$/,''); if(line.indexOf('data:')!==0)return;
            var data=line.slice(5).replace(/^\s+/,''); if(!data||data==='[DONE]')return;
            try{ var j=JSON.parse(data); var c=j.choices&&j.choices[0], d=c&&c.delta&&c.delta.content; if(d){ bot.text+=d; bot.phase=''; renderThread(); } }catch(e){}
          });
          pump();
        }).catch(function(e){ if(e!==0){ done(); } });
      };
      pump();
    })
    .catch(function(e){ if(e!==0){ bot.streaming=false; if(!bot.text)bot.text='⚠ '+_lt('⚠ launch failed'); setBusy(false); renderThread(); saveMsgs(); } });
}
/* Robust completion. The coder path has NO exit marker, so liveness rides on the launcher pid — which
   is UNRELIABLE two ways: it is 0 during the "starting…" window (agent not spawned yet) so the old
   poll saw alive:false and quit with "(no answer)" BEFORE the agent even ran (the phone bug); and a
   dead pid can be REUSED by the OS so alive stays true forever. So: never treat "not started yet" as
   done (wait until `→ running:` appears), then finish when the launcher is gone (2 reads) OR the
   output has been unchanged for ~10s (pid-reuse safety net). A generous tick cap covers a cold
   model load without hanging forever on a silent launch failure. */
function pollRun(id,bot){
  var started=false, deadReads=0, prevRaw='', stable=0, ticks=0;
  var finish=function(){ bot.streaming=false; setBusy(false); renderThread(); saveMsgs(); };
  var tick=function(){
    ticks++;
    getJSON('/control/coder/log?id='+encodeURIComponent(id)+'&tail=600')
      .then(function(j){
        var raw=j.log||'';
        if(/→ running:/.test(raw)) started=true;
        bot.text=cleanLog(raw); bot.phase=phaseOf(raw); renderThread();
        var answered=bot.text.length>0;
        if(raw===prevRaw){ stable++; } else { stable=0; prevRaw=raw; }
        deadReads = (started && !j.alive) ? deadReads+1 : 0;
        if(deadReads>=2 || (answered && stable>=8)){ finish(); return; }
        if(ticks>=140){ if(!bot.text) bot.text='⚠ '+_lt('⚠ launch failed'); finish(); return; }
        setTimeout(tick,1200);
      })
      .catch(function(e){ if(e!==0){ finish(); } });
  };
  setTimeout(tick,700);
}

send.addEventListener('click',doSend);
inp.addEventListener('keydown',function(e){ if(e.key==='Enter'&&!e.shiftKey){ e.preventDefault(); doSend(); } });
inp.addEventListener('input',function(){ inp.style.height='auto'; inp.style.height=Math.min(inp.scrollHeight,window.innerHeight*0.38)+'px'; });
$('cfgbtn').onclick=function(){ if(confirm('Очистить этот диалог и сменить настройки?')){ msgs=[]; saveMsgs(); } configured=false; localStorage.setItem('rozum_chat_ready','0'); showStart(); };

/* boot */
if(configured){ showChat(); } else { showStart(); }
refreshSys(); setInterval(refreshSys,5000);
