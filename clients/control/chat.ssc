  "#composer{display:flex;gap:8px;padding:8px max(10px,env(safe-area-inset-right)) max(8px,env(safe-area-inset-bottom)) max(10px,env(safe-area-inset-left));background:#10141c;border-top:1px solid #232a36;flex:0 0 auto}#inp{flex:1 1 auto;min-width:0;padding:11px 13px;background:#0b0e14;color:#e6e6e6;border:1px solid #2c3648;border-radius:11px;font-size:16px;font-family:-apple-system,system-ui,sans-serif;resize:none;max-height:38vh}#send{flex:0 0 auto;padding:0 17px;background:#1f3a28;color:#56d364;border:1px solid #2ea043;border-radius:11px;font-size:15px;font-weight:600;cursor:pointer}#send:active{background:#2a4d34}#send.busy{background:#3a2a1a;color:#e5a53b;border-color:#8a5a2a}"

val langCss = "#rozum-lang{position:fixed;top:9px;right:12px;display:flex;gap:1px;z-index:999}.rl-btn{background:#21262d;color:#6e7681;border:1px solid #30363d;padding:3px 7px;cursor:pointer;font-size:10px;font-weight:600;letter-spacing:.03em}.rl-btn:first-child{border-radius:5px 0 0 5px}.rl-btn:last-child{border-radius:0 5px 5px 0}.rl-btn.active{background:#1f3a28;border-color:#2ea043;color:#56d364}"

val js = """
var _LG=localStorage.getItem('rozum_lang')||navigator.language.split('-')[0]||'en';
var _LT={'ru':{'← UCC':'← UCC','rozum · chat':'rozum · чат','Chat with your project':'Чат с твоим проектом','Pick an agent + project. Every message runs the agent on the local model, in that project.':'Выбери агента и проект. Каждое сообщение запускает агента на локальной модели в этом проекте.','Agent':'Агент','Model':'Модель','Project':'Проект','▶ Start chatting':'▶ Начать','message…':'сообщение…','send':'отпр.','working…':'работает…','⚙':'⚙','Ask the agent to do something in the project.':'Попроси агента что-нибудь сделать в проекте.','⚠ launch failed':'⚠ не удалось запустить','(agent produced no output)':'(агент ничего не вывел)'},'uk':{'← UCC':'← UCC','rozum · chat':'rozum · чат','Chat with your project':'Чат з твоїм проєктом','Pick an agent + project. Every message runs the agent on the local model, in that project.':'Обери агента і проєкт. Кожне повідомлення запускає агента на локальній моделі в цьому проєкті.','Agent':'Агент','Model':'Модель','Project':'Проєкт','▶ Start chatting':'▶ Почати','message…':'повідомлення…','send':'надісл.','working…':'працює…','⚙':'⚙','Ask the agent to do something in the project.':'Попроси агента щось зробити в проєкті.','⚠ launch failed':'⚠ не вдалося запустити','(agent produced no output)':'(агент нічого не вивів)'}};
function _lt(s){var m=_LT[_LG];return(m&&m[s])||s;}
document.documentElement.lang=_LG;
if(_LT[_LG]&&_LT[_LG]['rozum · chat'])document.title=_LT[_LG]['rozum · chat'];
(function(){var d=document.createElement('div');d.id='rozum-lang';['en','ru','uk'].forEach(function(l){var b=document.createElement('button');b.className='rl-btn';b.textContent=l.toUpperCase();b.dataset.lang=l;b.onclick=function(){localStorage.setItem('rozum_lang',l);location.reload();};if(l===_LG)b.classList.add('active');d.appendChild(b);});document.body.appendChild(d);})();

var DEF_MODEL='mlx-community:Qwen3.5-4B-MLX-4bit';
var DEF_PROJECT='/Users/sergiy/work/my/rozum';
var AGENTS=['claude','codex','opencode'];
var cfg={agent:localStorage.getItem('rozum_chat_agent')||'claude',model:localStorage.getItem('rozum_chat_model')||DEF_MODEL,project:localStorage.getItem('rozum_chat_project')||DEF_PROJECT};
var configured=localStorage.getItem('rozum_chat_ready')==='1';
var msgs=[];   // {role:'user'|'bot', text}
var busy=false;

var $=function(s){return document.getElementById(s);};
var startEl=$('start'), threadEl=$('thread'), compEl=$('composer'), stEl=$('st'), metaEl=$('meta'), inp=$('inp'), send=$('send');

function on401(r){ if(r.status===401){ location.href='/login.html'; throw 0; } return r; }
function getJSON(u){ return fetch(u,{headers:{}}).then(on401).then(function(r){return r.json();}); }
function postJSON(u,b){ return fetch(u,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(b)}).then(on401).then(function(r){return r.json();}); }
function esc(s){return String(s).replace(/[&<>]/g,function(m){return{'&':'&amp;','<':'&lt;','>':'&gt;'}[m];});}

/* strip rozum-launch's own preamble/footer so the bubble shows the agent's real output */
function cleanLog(t){
  if(!t)return '';
  var drop=[/^rozum launch:/,/^context window:/,/^\s*→ running:/,/^\s*→ sandboxed/,/^⚠ claude\.ai/,/^\s*▐▛|^▝▜|^\s*▘▘/,/^\s*▎ /];
  return t.split('\n').filter(function(l){return !drop.some(function(re){return re.test(l);});}).join('\n').replace(/^\s+|\s+$/g,'');
}

/* ---------- start / config ---------- */
function renderStart(models,projects){
  var agentChips=AGENTS.map(function(a){return '<span class="chip'+(cfg.agent===a?' on':'')+'" data-agent="'+a+'">'+a+'</span>';}).join('');
  var modelOpts=(models&&models.length?models:[{spec:DEF_MODEL}]).map(function(m){var s=m.spec||m.id||m;return '<option value="'+esc(s)+'"'+(s===cfg.model?' selected':'')+'>'+esc(String(s).split('/').pop())+'</option>';}).join('');
  var projOpts=(projects&&projects.length?projects:[{name:'rozum',path:DEF_PROJECT}]).map(function(p){var pa=p.path||p;return '<option value="'+esc(pa)+'"'+(pa===cfg.project?' selected':'')+'>'+esc(p.name||String(pa).split('/').pop())+'</option>';}).join('');
  startEl.innerHTML=
    '<h2>'+_lt('Chat with your project')+'</h2><div class="sub">'+_lt('Pick an agent + project. Every message runs the agent on the local model, in that project.')+'</div>'+
    '<div class="grp"><div class="lbl">'+_lt('Agent')+'</div><div class="chips" id="agents">'+agentChips+'</div></div>'+
    '<div class="grp"><div class="lbl">'+_lt('Model')+'</div><select class="sel" id="mdl">'+modelOpts+'</select></div>'+
    '<div class="grp"><div class="lbl">'+_lt('Project')+'</div><select class="sel" id="prj">'+projOpts+'</select></div>'+
    '<button id="go">'+_lt('▶ Start chatting')+'</button>';
  $('agents').onclick=function(e){var c=e.target.closest('[data-agent]');if(!c)return;cfg.agent=c.dataset.agent;Array.prototype.forEach.call($('agents').children,function(x){x.classList.toggle('on',x.dataset.agent===cfg.agent);});};
  $('mdl').onchange=function(e){cfg.model=e.target.value;};
  $('prj').onchange=function(e){cfg.project=e.target.value;};
  $('go').onclick=function(){
    localStorage.setItem('rozum_chat_agent',cfg.agent);localStorage.setItem('rozum_chat_model',cfg.model);
    localStorage.setItem('rozum_chat_project',cfg.project);localStorage.setItem('rozum_chat_ready','1');
    configured=true; showChat(); inp.focus();
  };
}
function boot(){ getJSON('/control/status').then(function(s){renderStart(s.installed||s.models||[],s.projects||[]);}).catch(function(e){if(e!==0)renderStart([],[]);}); }

/* ---------- chat ---------- */
function setMeta(){ metaEl.innerHTML='<b>'+esc(cfg.agent)+' · '+esc(String(cfg.model).split('/').pop())+'</b><small>'+esc(String(cfg.project).split('/').pop())+'</small>'; }
function showStart(){ startEl.classList.remove('hidden'); threadEl.classList.add('hidden'); compEl.classList.add('hidden'); metaEl.innerHTML=''; boot(); }
function showChat(){ startEl.classList.add('hidden'); threadEl.classList.remove('hidden'); compEl.classList.remove('hidden'); setMeta(); inp.placeholder=_lt('message…'); send.textContent=_lt('send'); renderThread(); }
function renderThread(){
  if(!msgs.length){ threadEl.innerHTML='<div class="empty"><div class="big">🤖</div><div>'+_lt('Ask the agent to do something in the project.')+'</div></div>'; return; }
  threadEl.innerHTML=msgs.map(function(m){
    var who=m.role==='user'?'':'<div class="who">'+esc(cfg.agent)+'</div>';
    var body=m.role==='user'?esc(m.text):(esc(m.text)+(m.streaming?'<span class="cur"></span>':''));
    return '<div class="msg '+(m.role==='user'?'user':'bot')+'">'+who+'<div class="bubble">'+(body||(m.streaming?'':'<span style="color:#6b7280">'+_lt('(agent produced no output)')+'</span>'))+'</div></div>';
  }).join('');
  threadEl.scrollTop=threadEl.scrollHeight;
}
function setBusy(b){ busy=b; send.classList.toggle('busy',b); send.textContent=b?_lt('working…'):_lt('send'); stEl.textContent=b?'● '+_lt('working…'):''; }

function doSend(){
  var v=inp.value.trim(); if(!v||busy)return;
  msgs.push({role:'user',text:v});
  var bot={role:'bot',text:'',streaming:true}; msgs.push(bot);
  inp.value=''; inp.style.height='auto'; renderThread(); setBusy(true);
  postJSON('/control/coder/launch',{agent:cfg.agent,model:cfg.model,workdir:cfg.project,prompt:v,verify:false})
    .then(function(j){
      if(!j||!j.id){ bot.streaming=false; bot.text='⚠ '+_lt('⚠ launch failed'); setBusy(false); renderThread(); return; }
      pollRun(j.id,bot);
    })
    .catch(function(e){ if(e!==0){ bot.streaming=false; bot.text='⚠ '+_lt('⚠ launch failed'); setBusy(false); renderThread(); } });
}
function pollRun(id,bot){
  var dead=0;
  var tick=function(){
    getJSON('/control/coder/log?id='+encodeURIComponent(id)+'&tail=600')
      .then(function(j){
        bot.text=cleanLog(j.log||''); renderThread();
        if(j.alive){ dead=0; setTimeout(tick,1200); }
        else { dead++; if(dead<2){ setTimeout(tick,1200); } else { bot.streaming=false; setBusy(false); renderThread(); } }
      })
      .catch(function(e){ if(e!==0){ bot.streaming=false; setBusy(false); renderThread(); } });
  };
  setTimeout(tick,700);
}

send.addEventListener('click',doSend);
inp.addEventListener('keydown',function(e){ if(e.key==='Enter'&&!e.shiftKey){ e.preventDefault(); doSend(); } });
inp.addEventListener('input',function(){ inp.style.height='auto'; inp.style.height=Math.min(inp.scrollHeight,window.innerHeight*0.38)+'px'; });
$('cfgbtn').onclick=function(){ configured=false; localStorage.setItem('rozum_chat_ready','0'); showStart(); };

/* boot */
if(configured){ showChat(); } else { showStart(); }
"""

val html = "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\">" +
  "<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,maximum-scale=1,viewport-fit=cover\">" +
  "<meta name=\"apple-mobile-web-app-capable\" content=\"yes\"><meta name=\"apple-mobile-web-app-status-bar-style\" content=\"black-translucent\">" +
  "<title>rozum · chat</title><style>" + bodyCss + css + langCss + "</style></head><body>" +
  "<div id=\"app\">" +
    "<div id=\"bar\"><a href=\"/\">← UCC</a><div class=\"meta\" id=\"meta\"></div><span class=\"ic\" id=\"cfgbtn\">⚙</span><span id=\"st\"></span></div>" +
    "<div id=\"start\"></div>" +
    "<div id=\"thread\" class=\"hidden\"></div>" +
    "<div id=\"composer\" class=\"hidden\"><textarea id=\"inp\" rows=\"1\" autocomplete=\"off\" autocapitalize=\"sentences\"></textarea><button id=\"send\" type=\"button\">send</button></div>" +
  "</div><script>" + js + "</script></body></html>"

// Static page: printed to stdout for the deploy to capture (control-serve serves the file).
println(html)
```
