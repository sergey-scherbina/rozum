#!/usr/bin/env ssc
---
name: rozum-control-center
version: 1.1.0
description: rozum UCC — dashboard + native chat, one ssc PWA. Web (React) deploy build.
frontend: react
---
# rozum — control center (+ chat)

One std/ui app: a dashboard (live `/control/status`) AND a native chat view per room
(messages from `/chat/messages?room=…`, post via `/chat/post`) — same origin, so it all
stays inside the standalone PWA. Hash routing (`#/chat/<room>`) switches the view in place.

## Setup
[signal, emit, serve, fetchUrlSignal, fetchUrlSignalTo, fetchActionClear, fetchActionWith, formBody, onBumpTick, onSetSignal, incSignal, computedSignal, fieldColumn, stackedColumn, hashSignal, onOpenJson](std/ui/primitives.ssc)
[jsonValue](std/json.ssc)
[lower](std/ui/lower.ssc)
[darkTheme](std/ui/theme.ssc)
[vstack, hstack, divider](std/ui/layout.ssc)
[heading, text](std/ui/typography.ssc)
[link](std/ui/display.ssc)
[card, cardWithHeader, modal](std/ui/containers.ssc)
[signalText_](std/ui/reactive.ssc)
[actionButton, textField, signalLabelButton](std/ui/input.ssc)
[remoteTable, lcol, rowLink, rowPostAction, fieldPayload](std/ui/data.ssc)
[route, router](std/ui/routing.ssc)
[jobPanel](std/ui/patterns.ssc)

## State + routing
```scalascript
val refresh = signal("refresh", 0)
val st      = fetchUrlSignal("status", "/control/status", refresh)

val hash = hashSignal()
val room = computedSignal(() => {
  val h = hash()
  if h.contains("/chat/") then h.split("/chat/").last else ""
})
val mode = computedSignal(() => if hash().contains("/chat/") then "chat" else if hash().contains("/agents") then "agents" else if hash().contains("/coders") then "coders" else if hash().contains("/sessions") then "sessions" else if hash().contains("/messenger") then "messenger" else "home")
val isDetailOpen = computedSignal(() => hash().contains("/detail/"))

val detailSpec = computedSignal(() => { val h = hash(); if h.contains("/detail/") then h.split("/detail/").last else "" })
val detailUrl  = computedSignal(() => "/control/model/info?spec=" + detailSpec())
val detailTick = signal("detailTick", 0)
val detailData = fetchUrlSignalTo("modelDetail", detailUrl, detailTick)

val chatTick = signal("chatTick", 0)
val msgUrl   = computedSignal(() => "/chat/messages?room=" + room())
val messages = fetchUrlSignalTo("messages", msgUrl, chatTick)
val incUrl   = computedSignal(() => "/chat/incidents?room=" + room())
val incidents = fetchUrlSignalTo("incidents", incUrl, chatTick)
```

## Dashboard
```scalascript
def gib(b: Double): String = {
  val t = (b / 107374182.4).toInt
  (t / 10).toString + "." + (t % 10).toString + " GiB"
}
val availTxt     = computedSignal(() => gib(jsonValue(st()).get("residency").get("available_bytes").asDouble))
val budgetTxt    = computedSignal(() => gib(jsonValue(st()).get("residency").get("host_budget_bytes").asDouble))
val committedTxt = computedSignal(() => gib(jsonValue(st()).get("residency").get("committed_bytes").asDouble))

val meetingsCard = cardWithHeader(heading(2, "Meetings"))(
  remoteTable(st, [lcol("Room", "room", "#/chat/:value")], "meetings", [], "room")
)
val gwCard = cardWithHeader(hstack(gap = 10)(heading(2, "Memory"), actionButton(incSignal(refresh), "↻")))(
  vstack(gap = 6)(
    hstack(gap = 8)(text("free:"),  signalText_(availTxt)),
    hstack(gap = 8)(text("limit:"), signalText_(budgetTxt)),
    hstack(gap = 8)(text("used:"),  signalText_(committedTxt))
  )
)
val modelSelectCols = [stackedColumn("Model", "spec", "rating_line"), fieldColumn("GiB", "size_gib")]
// Models panel: Model + GiB, and ONE conditional action per row. The server sets exactly one of
// load_spec/stop_label (the other ""), so each rowPost auto-hides when its body is empty (std/ui
// skip-empty) — a load button for a not-loaded model, an unload button for the resident one; never
// both, never an empty column. rowPost is an async POST with immediate click feedback (the model
// load takes seconds; the button greys + shows … so it doesn't look dead). /gateway/stop ignores
// its body (stops the sole resident gateway), so stop_label doubles as the show/hide flag.
val modelsPanel = cardWithHeader(heading(2, "Models"))(
  remoteTable(st, [
    stackedColumn("Model", "spec", "load_status"),
    fieldColumn("GiB", "size_gib")
  ], "models", [
    rowPostAction("load",   "POST", "/control/gateway/load", "load_spec",  refresh),
    rowPostAction("unload", "POST", "/control/gateway/stop", "stop_label", refresh)
  ], "spec")
)

// The chat is the control center's front door: a prominent card + the first nav entry, linking the
// standalone /chat.html (an absolute-path full-page link, NOT the #/chat meeting-room route).
val chatCard = cardWithHeader(heading(2, "💬 Chat"))(
  vstack(gap = 8)(
    text("Talk to your local model, or drive a coding agent."),
    link("/chat.html", "Open chat →")
  )
)

val dashboard = vstack(gap = 16)(
  heading(1, "rozum — control center"),
  hstack(gap = 10)(link("/chat.html", "💬 Chat"), link("#/agents", "🤖 Agents"), link("#/coders", "💻 Coders"), link("#/sessions", "🖥 Sessions"), link("#/messenger", "📨 Боты"), link("/matrix.html", "📊 Matrix"), link("/login.html", "🔐 Login")),
  divider(),
  chatCard,
  divider(),
  meetingsCard,
  divider(),
  gwCard,
  divider(),
  modelsPanel
)
```

## Chat view
```scalascript
val chatHeader = hstack(gap = 10)(
  link("#/", "← back"),
  signalText_(computedSignal(() => "room: " + room())),
  actionButton(incSignal(chatTick), "↻")
)
val draft      = signal("draft", "")
val roomHeader = computedSignal(() => "{\"X-Room\":\"" + room() + "\"}")
val composer = hstack(gap = 8)(
  textField(draft, "message…"),
  actionButton(fetchActionClear("POST", "/chat/post", draft, chatTick, roomHeader), "send")
)
val incidentsCard = cardWithHeader(heading(2, "Room incidents"))(
  remoteTable(incidents, [
    fieldColumn("severity", "severity"),
    fieldColumn("state", "state"),
    fieldColumn("incident", "title"),
    fieldColumn("owner", "owner")
  ], "")
)
val chatBody = vstack(gap = 12)(
  chatHeader,
  divider(),
  incidentsCard,
  divider(),
  remoteTable(messages, [
    stackedColumn("", "content", "author")
  ], ""),
  composer
)
```

## Agents
```scalascript
val agModel   = signal("agModel", "")
val agRoom    = signal("agRoom", "")
val agPolicy  = signal("agPolicy", "mention")
val agPersona = signal("agPersona", "")

val agentModelList = remoteTable(st, modelSelectCols, "installed", [rowLink("select", agModel, "spec")], "spec")
val agentForm = vstack(gap = 8)(
  hstack(gap = 8)(text("free RAM:"), signalText_(availTxt)),
  hstack(gap = 8)(text("model:"), signalText_(agModel)),
  agentModelList,
  textField(agRoom, "room…"),
  textField(agPolicy, "reply policy: mention | always | manual"),
  textField(agPersona, "persona / context (optional)…")
)

val agentsBody = vstack(gap = 16)(
  hstack(gap = 10)(
    link("#/", "← back"),
    heading(1, "Agents"),
    actionButton(incSignal(refresh), "↻")
  ),
  divider(),
  jobPanel(st, refresh, "Running agents", [
      fieldColumn("agent", "handle"),
      fieldColumn("model", "model"),
      lcol("room", "room", "#/chat/:value"),
      fieldColumn("policy", "policy"),
      fieldColumn("status", "status")
    ], "agents", "/control/agent/stop",
    "Launch agent (model + room)", agentForm,
    "🤖 launch (RAM check)", "/control/agent/launch",
    [("model", "agModel"), ("room", "agRoom"), ("policy", "agPolicy"), ("persona", "agPersona")])
)
```

## Coders
```scalascript
val cdAgent   = signal("cdAgent", "claude")
val cdModel   = signal("cdModel", "")
val cdWorkdir = signal("cdWorkdir", "")
val cdPrompt  = signal("cdPrompt", "")
val newProjectPath = signal("newProjectPath", "")
val cdLogId   = signal("cdLogId", "")
val logTick   = signal("logTick", 0)
val cdLogUrl  = computedSignal(() => "/control/coder/log?id=" + cdLogId() + "&tail=120")
val cdLog     = fetchUrlSignalTo("coderLog", cdLogUrl, logTick)
val cdLogText = computedSignal(() => jsonValue(cdLog()).get("log").asString)

val cdAgentClaudeLbl   = computedSignal(() => if cdAgent() == "claude"   then "✓ claude"   else "claude")
val cdAgentCodexLbl    = computedSignal(() => if cdAgent() == "codex"    then "✓ codex"    else "codex")
val cdAgentOpencodeLbl = computedSignal(() => if cdAgent() == "opencode" then "✓ opencode" else "opencode")

val coderModelList = remoteTable(st, modelSelectCols, "installed", [rowLink("select", cdModel, "spec")], "spec")
val coderWorkdirList = remoteTable(st, [fieldColumn("project", "name")], "projects", [rowLink("select", cdWorkdir, "path")], "path")
val coderForm = vstack(gap = 8)(
  hstack(gap = 8)(text("free RAM:"), signalText_(availTxt)),
  vstack(gap = 4)(
    hstack(gap = 8)(text("agent:"), signalText_(cdAgent)),
    hstack(gap = 8)(signalLabelButton(cdAgent, "claude", cdAgentClaudeLbl), signalLabelButton(cdAgent, "codex", cdAgentCodexLbl), signalLabelButton(cdAgent, "opencode", cdAgentOpencodeLbl))
  ),
  hstack(gap = 8)(text("model:"), signalText_(cdModel)),
  coderModelList,
  vstack(gap = 4)(
    hstack(gap = 8)(text("folder:"), signalText_(cdWorkdir)),
    coderWorkdirList,
    hstack(gap = 8)(textField(newProjectPath, "project name…"), actionButton(fetchActionWith("POST", "/control/project/add", formBody([("name", "newProjectPath")]), [onBumpTick(refresh)]), "＋ create"))
  ),
  textField(cdPrompt, "task…")
)

val coderLogCard = cardWithHeader(heading(2, "Coder log"))(
  vstack(gap = 8)(
    hstack(gap = 8)(textField(cdLogId, "coder id (from list)…"), actionButton(incSignal(logTick), "↻ log")),
    signalText_(cdLogText)
  )
)

val codersBody = vstack(gap = 16)(
  hstack(gap = 10)(link("#/", "← back"), heading(1, "Coders"), actionButton(incSignal(refresh), "↻")),
  divider(),
  jobPanel(st, refresh, "Running coders", [
      fieldColumn("agent", "agent"),
      fieldColumn("model", "model"),
      fieldColumn("repo", "workdir"),
      fieldColumn("status", "status"),
      fieldColumn("id", "id")
    ], "coders", "/control/coder/stop",
    "Launch coder (real work in repo)", coderForm,
    "💻 launch (RAM check)", "/control/coder/launch",
    [("agent", "cdAgent"), ("model", "cdModel"), ("workdir", "cdWorkdir"), ("prompt", "cdPrompt")]),
  divider(),
  coderLogCard
)
```

## Sessions
```scalascript
val seAgent   = signal("seAgent", "claude")
val seModel   = signal("seModel", "")
val seWorkdir = signal("seWorkdir", "")
val sePrompt  = signal("sePrompt", "")

val seAgentClaudeLbl   = computedSignal(() => if seAgent() == "claude"   then "✓ claude"   else "claude")
val seAgentCodexLbl    = computedSignal(() => if seAgent() == "codex"    then "✓ codex"    else "codex")
val seAgentOpencodeLbl = computedSignal(() => if seAgent() == "opencode" then "✓ opencode" else "opencode")

val sessionModelList = remoteTable(st, modelSelectCols, "installed", [rowLink("select", seModel, "spec")], "spec")
val sessionWorkdirList = remoteTable(st, [fieldColumn("project", "name")], "projects", [rowLink("select", seWorkdir, "path")], "path")
val sessionForm = vstack(gap = 8)(
  hstack(gap = 8)(text("free RAM:"), signalText_(availTxt)),
  vstack(gap = 4)(
    hstack(gap = 8)(text("agent:"), signalText_(seAgent)),
    hstack(gap = 8)(signalLabelButton(seAgent, "claude", seAgentClaudeLbl), signalLabelButton(seAgent, "codex", seAgentCodexLbl), signalLabelButton(seAgent, "opencode", seAgentOpencodeLbl))
  ),
  hstack(gap = 8)(text("model:"), signalText_(seModel)),
  sessionModelList,
  vstack(gap = 4)(
    hstack(gap = 8)(text("folder:"), signalText_(seWorkdir)),
    sessionWorkdirList,
    hstack(gap = 8)(textField(newProjectPath, "project name…"), actionButton(fetchActionWith("POST", "/control/project/add", formBody([("name", "newProjectPath")]), [onBumpTick(refresh)]), "＋ create"))
  ),
  textField(sePrompt, "first task (optional)…")
)

val sessionsBody = vstack(gap = 16)(
  hstack(gap = 10)(link("#/", "← back"), heading(1, "Sessions"), actionButton(incSignal(refresh), "↻"), link("/login.html", "🔐 Login")),
  divider(),
  jobPanel(st, refresh, "Live sessions", [
      fieldColumn("agent", "agent"),
      fieldColumn("model", "model"),
      fieldColumn("repo", "workdir"),
      fieldColumn("status", "status"),
      lcol("💬 chat", "id", "/session.html?id=:value"),
      lcol("🖥 term", "id", "/terminal.html?id=:value")
    ], "sessions", "/control/session/stop",
    "New interactive session", sessionForm,
    "💬 launch session", "/control/session/launch",
    [("agent", "seAgent"), ("model", "seModel"), ("workdir", "seWorkdir"), ("prompt", "sePrompt")],
    [onOpenJson("/session.html?id=:value", "id")])
)
```

## Messenger — bots, groups, rosters
```scalascript
// Everything on this screen renders from ONE signal, and every mutation goes to
// /control/messenger/* which runs `rozum-gateway messenger … --json` — the same code path as
// the CLI and the in-chat commands, so the console can't drift from the shell.
// Spec: docs/specs/messenger-admin-console.md.
val msgTick = signal("msgTick", 0)
val msg     = fetchUrlSignal("messenger", "/control/messenger/status", msgTick)

// Bots. The server sets exactly one of stop_body / start_body (the other ""), and the table
// skips a row action with an empty body — so a live bot offers "стоп", a dead one "старт".
val botsPanel = cardWithHeader(hstack(gap = 10)(heading(2, "Боты"), actionButton(incSignal(msgTick), "↻")))(
  remoteTable(msg, [
    stackedColumn("Бот", "username", "state_line"),
    stackedColumn("Комната", "room", "groups_line")
  ], "bots", [
    rowPostAction("↻",     "POST", "/control/messenger/bot/service", "restart_body", msgTick),
    rowPostAction("■ стоп", "POST", "/control/messenger/bot/service", "stop_body",    msgTick),
    rowPostAction("▶ старт","POST", "/control/messenger/bot/service", "start_body",   msgTick)
  ], "name")
)

val newBotName  = signal("newBotName", "")
val newBotToken = signal("newBotToken", "")
val newBotRoom  = signal("newBotRoom", "")
val newBotAlias = signal("newBotAlias", "")
// The token is cleared from the page on success (onSetSignal) — it is write-only: the server
// stores it 600 and никогда не отдаёт обратно, so nothing on this screen can ever display one.
val addBotCard = cardWithHeader(heading(2, "Добавить бота"))(
  vstack(gap = 8)(
    text("Токен от @BotFather. Он проверяется через getMe ДО записи на диск и больше никогда не покидает машину."),
    textField(newBotName,  "имя (латиница, напр. groups)…"),
    textField(newBotToken, "токен…"),
    textField(newBotRoom,  "комната личного чата (по умолчанию = имя)…"),
    textField(newBotAlias, "как звать в группах, напр. @my_bot…"),
    actionButton(fetchActionWith("POST", "/control/messenger/bot/add",
      formBody([("name", "newBotName"), ("token", "newBotToken"), ("room", "newBotRoom"), ("mention_alias", "newBotAlias")]),
      [onBumpTick(msgTick), onSetSignal(newBotToken, "")]), "＋ добавить бота"),
    text("После установки откройте бота в Telegram и нажмите Start — до этого личного чата не существует и мост его не провалидирует.")
  )
)

// Groups: one flat list across every registry, each row carrying its own remove body.
val newGroupRegistry = signal("newGroupRegistry", "telegram")
val newGroupChatId   = signal("newGroupChatId", "")
val newGroupRoom     = signal("newGroupRoom", "")
val newGroupTitle    = signal("newGroupTitle", "")

val groupsPanel = cardWithHeader(heading(2, "Группы"))(
  remoteTable(msg, [
    stackedColumn("Чат", "chat_id", "title"),
    stackedColumn("Куда", "where_line", "registry")
  ], "groups", [
    rowPostAction("✕ отключить", "POST", "/control/messenger/group/remove", "remove_body", msgTick)
  ], "chat_id")
)

val addGroupCard = cardWithHeader(heading(2, "Подключить группу"))(
  vstack(gap = 8)(
    text("id группы — отрицательное число. Бот должен быть в группе администратором, иначе он не увидит сообщений."),
    textField(newGroupRegistry, "реестр (telegram | telegram-groups)…"),
    textField(newGroupChatId,   "id чата, напр. -1004378341901…"),
    textField(newGroupRoom,     "комната (пусто = group-<id>)…"),
    textField(newGroupTitle,    "название…"),
    actionButton(fetchActionWith("POST", "/control/messenger/group/add",
      formBody([("registry", "newGroupRegistry"), ("chat_id", "newGroupChatId"), ("room", "newGroupRoom"), ("title", "newGroupTitle")]),
      [onBumpTick(msgTick), onSetSignal(newGroupChatId, "")]), "＋ подключить"),
    text("Мост подхватит изменение сам — он следит за своим реестром и перезапускается.")
  )
)

// Rosters. Pick a room, see who may do what, grant/revoke — the /grant, /revoke, /members
// commands, for the case where the chat is exactly what you can't reach.
val aclRoom   = signal("aclRoom", "")
val aclTick   = signal("aclTick", 0)
val aclUrl    = computedSignal(() => "/control/messenger/acl?room=" + aclRoom())
val aclData   = fetchUrlSignalTo("messengerAcl", aclUrl, aclTick)
val aclUserId = signal("aclUserId", "")
val aclName   = signal("aclName", "")
val aclCaps   = signal("aclCaps", "chat")

val aclRoomsPanel = cardWithHeader(heading(2, "Комнаты"))(
  remoteTable(msg, [fieldColumn("Комната", "room")], "acl_rooms", [rowLink("выбрать", aclRoom, "room")], "room")
)

val aclPanel = cardWithHeader(hstack(gap = 10)(heading(2, "Права"), signalText_(aclRoom), actionButton(incSignal(aclTick), "↻")))(
  vstack(gap = 8)(
    remoteTable(aclData, [
      stackedColumn("Кто", "user_id", "name"),
      fieldColumn("Права", "caps")
    ], "members", [], "user_id"),
    textField(aclUserId, "telegram user id…"),
    textField(aclName,   "имя (необязательно)…"),
    textField(aclCaps,   "права: chat read write shell | all | none"),
    hstack(gap = 8)(
      actionButton(fetchActionWith("POST", "/control/messenger/acl/grant",
        formBody([("room", "aclRoom"), ("user_id", "aclUserId"), ("name", "aclName"), ("caps", "aclCaps")]),
        [onBumpTick(aclTick)]), "✓ выдать"),
      actionButton(fetchActionWith("POST", "/control/messenger/acl/revoke",
        formBody([("room", "aclRoom"), ("user_id", "aclUserId")]),
        [onBumpTick(aclTick)]), "✕ отозвать")
    )
  )
)

val messengerBody = vstack(gap = 16)(
  hstack(gap = 10)(link("#/", "← back"), heading(1, "Мессенджер"), actionButton(incSignal(msgTick), "↻")),
  divider(),
  botsPanel,
  addBotCard,
  divider(),
  groupsPanel,
  addGroupCard,
  divider(),
  aclRoomsPanel,
  aclPanel
)
```

## Model detail
```scalascript
val detailDisplayName = computedSignal(() => jsonValue(detailData()).get("display_name").asString)
val detailName        = computedSignal(() => { val n = detailDisplayName(); if n != "" then n else jsonValue(detailData()).get("name").asString })
val detailSpec_       = computedSignal(() => jsonValue(detailData()).get("spec").asString)
val detailSrc         = computedSignal(() => jsonValue(detailData()).get("source").asString)
val detailGib         = computedSignal(() => jsonValue(detailData()).get("size_gib").asString + " GiB")
val detailPath        = computedSignal(() => jsonValue(detailData()).get("path").asString)
val detailModelType   = computedSignal(() => jsonValue(detailData()).get("model_type").asString)
val detailMaxCtx      = computedSignal(() => { val c = jsonValue(detailData()).get("max_ctx").asString; if c != "" then c + " tokens" else "" })
val detailLayers      = computedSignal(() => jsonValue(detailData()).get("num_layers").asString)
val detailAttnHeads   = computedSignal(() => jsonValue(detailData()).get("num_attn_heads").asString)
val detailKvHeads     = computedSignal(() => jsonValue(detailData()).get("num_kv_heads").asString)
val detailHidden      = computedSignal(() => jsonValue(detailData()).get("hidden_size").asString)
val detailQuant       = computedSignal(() => jsonValue(detailData()).get("quant").asString)
val detailExperts     = computedSignal(() => { val n = jsonValue(detailData()).get("n_experts").asString; val k = jsonValue(detailData()).get("experts_per_tok").asString; if n != "" then n + " experts, top-" + k else "" })
val detailNotes       = computedSignal(() => jsonValue(detailData()).get("notes").asString)
val detailPid         = computedSignal(() => jsonValue(detailData()).get("resident").get("pid").asString)
val detailPort        = computedSignal(() => jsonValue(detailData()).get("resident").get("port").asString)
val detailResidentTxt = computedSignal(() => { val pid = detailPid(); if pid == "" || pid == "0" then "no" else "yes  (PID " + pid + ", port " + detailPort() + ")" })

val detailModal = modal(isDetailOpen, "Model details")(
  link("#/", "✕"),
  vstack(gap = 10)(
    signalText_(detailName),
    hstack(gap = 8)(text("Spec:"),          signalText_(detailSpec_)),
    hstack(gap = 8)(text("Architecture:"),  signalText_(detailModelType)),
    hstack(gap = 8)(text("Quantization:"),  signalText_(detailQuant)),
    hstack(gap = 8)(text("Context:"),       signalText_(detailMaxCtx)),
    hstack(gap = 8)(text("Layers:"),        signalText_(detailLayers)),
    hstack(gap = 8)(text("Attn:"),          signalText_(detailAttnHeads)),
    hstack(gap = 8)(text("KV:"),            signalText_(detailKvHeads)),
    hstack(gap = 8)(text("Hidden:"),        signalText_(detailHidden)),
    hstack(gap = 8)(text("MoE:"),           signalText_(detailExperts)),
    hstack(gap = 8)(text("Size:"),          signalText_(detailGib)),
    hstack(gap = 8)(text("Resident:"),      signalText_(detailResidentTxt)),
    hstack(gap = 8)(text("Notes:"),         signalText_(detailNotes))
  )
)

```

## Compose + serve
```scalascript
val view = vstack(gap = 0)(
  router(mode, [
    route("home",     [dashboard]),
    route("chat",     [chatBody]),
    route("agents",   [agentsBody]),
    route("coders",   [codersBody]),
    route("sessions", [sessionsBody]),
    route("messenger", [messengerBody])
  ]),
  detailModal
)

serve(lower(view, darkTheme), 8410, "body{background:#111827}")
```
