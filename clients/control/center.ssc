#!/usr/bin/env ssc
---
name: rozum-control-center
version: 1.1.0
description: rozum UCC — dashboard + native chat, one ssc PWA. Web (React) deploy build.
frontend: react
---
# rozum — control center (+ chat)

One std/ui app: a dashboard (live `/control/status`) AND a native chat view per room
(messages from `/chat/messages?room=…`, post via `/chat/post`) — same origin, so it all
stays inside the standalone PWA. Hash routing (`#/chat/<room>`) switches the view in place.

## Setup
[signal, emit, serve, fetchUrlSignal, fetchUrlSignalTo, fetchActionClear, fetchActionWith, formBody, onBumpTick, incSignal, computedSignal, fieldColumn, stackedColumn, hashSignal](std/ui/primitives.ssc)
[jsonValue](std/json.ssc)
[lower](std/ui/lower.ssc)
[darkTheme](std/ui/theme.ssc)
[vstack, hstack, divider](std/ui/layout.ssc)
[heading, text](std/ui/typography.ssc)
[badge, link](std/ui/display.ssc)
[card, cardWithHeader, modal](std/ui/containers.ssc)
[signalText_](std/ui/reactive.ssc)
[actionButton, textField, signalLabelButton](std/ui/input.ssc)
[remoteTable, lcol, rowLink, rowPostAction, fieldPayload](std/ui/data.ssc)
[route, router](std/ui/routing.ssc)

## State + routing
```scalascript
val refresh = signal("refresh", 0)
val st      = fetchUrlSignal("status", "/control/status", refresh)

val hash = hashSignal()
val room = computedSignal(() => {
  val h = hash()
  if h.contains("/chat/") then h.split("/chat/").last else ""
})
val mode = computedSignal(() => if hash().contains("/chat/") then "chat" else if hash().contains("/agents") then "agents" else if hash().contains("/coders") then "coders" else if hash().contains("/sessions") then "sessions" else "home")
val isDetailOpen = computedSignal(() => hash().contains("/detail/"))

val detailSpec = computedSignal(() => { val h = hash(); if h.contains("/detail/") then h.split("/detail/").last else "" })
val detailUrl  = computedSignal(() => "/control/model/info?spec=" + detailSpec())
val detailTick = signal("detailTick", 0)
val detailData = fetchUrlSignalTo("modelDetail", detailUrl, detailTick)

val chatTick = signal("chatTick", 0)
val msgUrl   = computedSignal(() => "/chat/messages?room=" + room())
val messages = fetchUrlSignalTo("messages", msgUrl, chatTick)
val incUrl   = computedSignal(() => "/chat/incidents?room=" + room())
val incidents = fetchUrlSignalTo("incidents", incUrl, chatTick)
```

## Dashboard
```scalascript
def gib(b: Double): String = {
  val t = (b / 107374182.4).toInt
  (t / 10).toString + "." + (t % 10).toString + " GiB"
}
val availTxt     = computedSignal(() => gib(jsonValue(st()).get("residency").get("available_bytes").asDouble))
val budgetTxt    = computedSignal(() => gib(jsonValue(st()).get("residency").get("host_budget_bytes").asDouble))
val committedTxt = computedSignal(() => gib(jsonValue(st()).get("residency").get("committed_bytes").asDouble))

val meetingsCard = cardWithHeader(heading(2, "Meetings"))(
  remoteTable(st, [lcol("Room", "room", "#/chat/:value")], "meetings")
)
val gwCard = cardWithHeader(heading(2, "Gateway / residency"))(
  vstack(gap = 6)(
    hstack(gap = 8)(
      text("source:"), badge("rozum control-API (always-up)", "success"),
      actionButton(incSignal(refresh), "↻ refresh")
    ),
    hstack(gap = 8)(text("available:"),   signalText_(availTxt)),
    hstack(gap = 8)(text("host budget:"), signalText_(budgetTxt)),
    hstack(gap = 8)(text("committed:"),   signalText_(committedTxt))
  )
)
val modelSelectCols = [stackedColumn("Model", "spec", "stars"), fieldColumn("GiB", "size_gib")]
val modelsPanel = cardWithHeader(heading(2, "Models"))(
  remoteTable(st, [
    lcol("Model", "spec",       "#/detail/:value"),
    fieldColumn("GiB", "size_gib"),
    lcol("",       "load_spec",  "/control/gateway/load?model=:value"),
    lcol("",       "stop_label", "/control/gateway/stop?k=:value")
  ], "models")
)

val dashboard = vstack(gap = 16)(
  heading(1, "rozum — control center"),
  hstack(gap = 10)(link("#/agents", "🤖 Agents"), link("#/coders", "💻 Coders"), link("#/sessions", "🖥 Sessions"), link("/matrix.html", "📊 Matrix"), link("/login.html", "🔐 Login")),
  divider(),
  meetingsCard,
  divider(),
  gwCard,
  divider(),
  modelsPanel
)
```

## Chat view
```scalascript
val chatHeader = hstack(gap = 10)(
  link("#/", "← back"),
  signalText_(computedSignal(() => "room: " + room())),
  actionButton(incSignal(chatTick), "↻")
)
val draft      = signal("draft", "")
val roomHeader = computedSignal(() => "{\"X-Room\":\"" + room() + "\"}")
val composer = hstack(gap = 8)(
  textField(draft, "message…"),
  actionButton(fetchActionClear("POST", "/chat/post", draft, chatTick, roomHeader), "send")
)
val incidentsCard = cardWithHeader(heading(2, "Room incidents"))(
  remoteTable(incidents, [
    fieldColumn("severity", "severity"),
    fieldColumn("state", "state"),
    fieldColumn("incident", "title"),
    fieldColumn("owner", "owner")
  ], "")
)
val chatBody = vstack(gap = 12)(
  chatHeader,
  divider(),
  incidentsCard,
  divider(),
  remoteTable(messages, [
    fieldColumn("", "time"),
    fieldColumn("", "author"),
    fieldColumn("", "content")
  ], ""),
  composer
)
```

## Agents
```scalascript
val agModel   = signal("agModel", "")
val agRoom    = signal("agRoom", "")
val agPolicy  = signal("agPolicy", "mention")
val agPersona = signal("agPersona", "")
val stopId    = signal("stopId", "")

val agentsList = cardWithHeader(heading(2, "Running agents"))(
  remoteTable(st, [
    fieldColumn("agent", "handle"),
    fieldColumn("model", "model"),
    lcol("room", "room", "#/chat/:value"),
    fieldColumn("policy", "policy"),
    fieldColumn("id", "id")
  ], "agents")
)
val agentModelList = remoteTable(st, modelSelectCols, "installed", [rowLink("select", agModel, "spec")])
val launchForm = cardWithHeader(heading(2, "Launch agent (model + room)"))(
  vstack(gap = 8)(
    hstack(gap = 8)(text("free RAM:"), signalText_(availTxt)),
    hstack(gap = 8)(text("model:"), signalText_(agModel)),
    agentModelList,
    textField(agRoom, "room…"),
    textField(agPolicy, "reply policy: mention | always | manual"),
    textField(agPersona, "persona / context (optional)…"),
    actionButton(
      fetchActionWith("POST", "/control/agent/launch",
        formBody([("model", "agModel"), ("room", "agRoom"), ("policy", "agPolicy"), ("persona", "agPersona")]),
        [onBumpTick(refresh)]),
      "🤖 launch (RAM check)")
  )
)

val stopForm = cardWithHeader(heading(2, "Stop agent"))(
  hstack(gap = 8)(
    textField(stopId, "agent id (from list)…"),
    actionButton(
      fetchActionWith("POST", "/control/agent/stop", formBody([("id", "stopId")]), [onBumpTick(refresh)]),
      "stop")
  )
)

val agentsBody = vstack(gap = 16)(
  hstack(gap = 10)(
    link("#/", "← back"),
    heading(1, "Agents"),
    actionButton(incSignal(refresh), "↻")
  ),
  divider(),
  agentsList,
  divider(),
  launchForm,
  divider(),
  stopForm
)
```

## Coders
```scalascript
val cdAgent   = signal("cdAgent", "claude")
val cdModel   = signal("cdModel", "")
val cdWorkdir = signal("cdWorkdir", "")
val cdPrompt  = signal("cdPrompt", "")
val newProjectPath = signal("newProjectPath", "")
val cdLogId   = signal("cdLogId", "")
val cdStopId  = signal("cdStopId", "")
val logTick   = signal("logTick", 0)
val cdLogUrl  = computedSignal(() => "/control/coder/log?id=" + cdLogId() + "&tail=120")
val cdLog     = fetchUrlSignalTo("coderLog", cdLogUrl, logTick)
val cdLogText = computedSignal(() => jsonValue(cdLog()).get("log").asString)

val cdAgentClaudeLbl   = computedSignal(() => if cdAgent() == "claude"   then "✓ claude"   else "claude")
val cdAgentCodexLbl    = computedSignal(() => if cdAgent() == "codex"    then "✓ codex"    else "codex")
val cdAgentOpencodeLbl = computedSignal(() => if cdAgent() == "opencode" then "✓ opencode" else "opencode")

val codersList = cardWithHeader(heading(2, "Running coders"))(
  remoteTable(st, [
    fieldColumn("agent", "agent"),
    fieldColumn("model", "model"),
    fieldColumn("repo", "workdir"),
    fieldColumn("alive", "alive"),
    fieldColumn("id", "id")
  ], "coders")
)
val coderModelList = remoteTable(st, modelSelectCols, "installed", [rowLink("select", cdModel, "spec")])
val coderWorkdirList = remoteTable(st, [fieldColumn("project", "name")], "projects", [rowLink("select", cdWorkdir, "path")])
val coderLaunch = cardWithHeader(heading(2, "Launch coder (real work in repo)"))(
  vstack(gap = 8)(
    hstack(gap = 8)(text("free RAM:"), signalText_(availTxt)),
    vstack(gap = 4)(
      hstack(gap = 8)(text("agent:"), signalText_(cdAgent)),
      hstack(gap = 8)(signalLabelButton(cdAgent, "claude", cdAgentClaudeLbl), signalLabelButton(cdAgent, "codex", cdAgentCodexLbl), signalLabelButton(cdAgent, "opencode", cdAgentOpencodeLbl))
    ),
    hstack(gap = 8)(text("model:"), signalText_(cdModel)),
    coderModelList,
    vstack(gap = 4)(
      hstack(gap = 8)(text("folder:"), signalText_(cdWorkdir)),
      coderWorkdirList,
      hstack(gap = 8)(textField(newProjectPath, "project name…"), actionButton(fetchActionWith("POST", "/control/project/add", formBody([("name", "newProjectPath")]), [onBumpTick(refresh)]), "＋ create"))
    ),
    textField(cdPrompt, "task…"),
    actionButton(
      fetchActionWith("POST", "/control/coder/launch",
        formBody([("agent", "cdAgent"), ("model", "cdModel"), ("workdir", "cdWorkdir"), ("prompt", "cdPrompt")]),
        [onBumpTick(refresh)]),
      "💻 launch (RAM check)")
  )
)

val coderLogCard = cardWithHeader(heading(2, "Coder log"))(
  vstack(gap = 8)(
    hstack(gap = 8)(textField(cdLogId, "coder id (from list)…"), actionButton(incSignal(logTick), "↻ log")),
    signalText_(cdLogText)
  )
)

val coderStop = cardWithHeader(heading(2, "Stop coder"))(
  hstack(gap = 8)(
    textField(cdStopId, "coder id…"),
    actionButton(fetchActionWith("POST", "/control/coder/stop", formBody([("id", "cdStopId")]), [onBumpTick(refresh)]), "stop")
  )
)

val codersBody = vstack(gap = 16)(
  hstack(gap = 10)(link("#/", "← back"), heading(1, "Coders"), actionButton(incSignal(refresh), "↻")),
  divider(),
  codersList,
  divider(),
  coderLaunch,
  divider(),
  coderLogCard,
  divider(),
  coderStop
)
```

## Sessions
```scalascript
val seAgent   = signal("seAgent", "claude")
val seModel   = signal("seModel", "")
val seWorkdir = signal("seWorkdir", "")
val sePrompt  = signal("sePrompt", "")

val seAgentClaudeLbl   = computedSignal(() => if seAgent() == "claude"   then "✓ claude"   else "claude")
val seAgentCodexLbl    = computedSignal(() => if seAgent() == "codex"    then "✓ codex"    else "codex")
val seAgentOpencodeLbl = computedSignal(() => if seAgent() == "opencode" then "✓ opencode" else "opencode")

val sessionsList = cardWithHeader(heading(2, "Live sessions (terminal)"))(
  remoteTable(st, [
    fieldColumn("agent", "agent"),
    fieldColumn("model", "model"),
    fieldColumn("repo", "workdir"),
    lcol("🖥 terminal", "id", "/terminal.html?id=:value")
  ], "sessions", [rowPostAction("✕ close", "POST", "/control/session/stop", fieldPayload("id"), refresh)])
)
val sessionModelList = remoteTable(st, modelSelectCols, "installed", [rowLink("select", seModel, "spec")])
val sessionWorkdirList = remoteTable(st, [fieldColumn("project", "name")], "projects", [rowLink("select", seWorkdir, "path")])
val sessionLaunch = cardWithHeader(heading(2, "New interactive session"))(
  vstack(gap = 8)(
    hstack(gap = 8)(text("free RAM:"), signalText_(availTxt)),
    vstack(gap = 4)(
      hstack(gap = 8)(text("agent:"), signalText_(seAgent)),
      hstack(gap = 8)(signalLabelButton(seAgent, "claude", seAgentClaudeLbl), signalLabelButton(seAgent, "codex", seAgentCodexLbl), signalLabelButton(seAgent, "opencode", seAgentOpencodeLbl))
    ),
    hstack(gap = 8)(text("model:"), signalText_(seModel)),
    sessionModelList,
    vstack(gap = 4)(
      hstack(gap = 8)(text("folder:"), signalText_(seWorkdir)),
      sessionWorkdirList,
      hstack(gap = 8)(textField(newProjectPath, "project name…"), actionButton(fetchActionWith("POST", "/control/project/add", formBody([("name", "newProjectPath")]), [onBumpTick(refresh)]), "＋ create"))
    ),
    textField(sePrompt, "first task (optional)…"),
    actionButton(
      fetchActionWith("POST", "/control/session/launch",
        formBody([("agent", "seAgent"), ("model", "seModel"), ("workdir", "seWorkdir"), ("prompt", "sePrompt")]),
        [onBumpTick(refresh)]),
      "🖥 launch session")
  )
)

val sessionsBody = vstack(gap = 16)(
  hstack(gap = 10)(link("#/", "← back"), heading(1, "Sessions"), actionButton(incSignal(refresh), "↻"), link("/login.html", "🔐 Login")),
  divider(),
  sessionsList,
  divider(),
  sessionLaunch
)
```

## Model detail
```scalascript
val detailDisplayName = computedSignal(() => jsonValue(detailData()).get("display_name").asString)
val detailName        = computedSignal(() => { val n = detailDisplayName(); if n != "" then n else jsonValue(detailData()).get("name").asString })
val detailSpec_       = computedSignal(() => jsonValue(detailData()).get("spec").asString)
val detailSrc         = computedSignal(() => jsonValue(detailData()).get("source").asString)
val detailGib         = computedSignal(() => jsonValue(detailData()).get("size_gib").asString + " GiB")
val detailPath        = computedSignal(() => jsonValue(detailData()).get("path").asString)
val detailModelType   = computedSignal(() => jsonValue(detailData()).get("model_type").asString)
val detailMaxCtx      = computedSignal(() => { val c = jsonValue(detailData()).get("max_ctx").asString; if c != "" then c + " tokens" else "" })
val detailLayers      = computedSignal(() => jsonValue(detailData()).get("num_layers").asString)
val detailAttnHeads   = computedSignal(() => jsonValue(detailData()).get("num_attn_heads").asString)
val detailKvHeads     = computedSignal(() => jsonValue(detailData()).get("num_kv_heads").asString)
val detailHidden      = computedSignal(() => jsonValue(detailData()).get("hidden_size").asString)
val detailQuant       = computedSignal(() => jsonValue(detailData()).get("quant").asString)
val detailExperts     = computedSignal(() => { val n = jsonValue(detailData()).get("n_experts").asString; val k = jsonValue(detailData()).get("experts_per_tok").asString; if n != "" then n + " experts, top-" + k else "" })
val detailNotes       = computedSignal(() => jsonValue(detailData()).get("notes").asString)
val detailPid         = computedSignal(() => jsonValue(detailData()).get("resident").get("pid").asString)
val detailPort        = computedSignal(() => jsonValue(detailData()).get("resident").get("port").asString)
val detailResidentTxt = computedSignal(() => { val pid = detailPid(); if pid == "" || pid == "0" then "no" else "yes  (PID " + pid + ", port " + detailPort() + ")" })

val detailModal = modal(isDetailOpen, "Model details")(
  link("#/", "✕"),
  vstack(gap = 10)(
    signalText_(detailName),
    hstack(gap = 8)(text("Spec:"),          signalText_(detailSpec_)),
    hstack(gap = 8)(text("Architecture:"),  signalText_(detailModelType)),
    hstack(gap = 8)(text("Quantization:"),  signalText_(detailQuant)),
    hstack(gap = 8)(text("Context:"),       signalText_(detailMaxCtx)),
    hstack(gap = 8)(text("Layers:"),        signalText_(detailLayers)),
    hstack(gap = 8)(text("Attn:"),          signalText_(detailAttnHeads)),
    hstack(gap = 8)(text("KV:"),            signalText_(detailKvHeads)),
    hstack(gap = 8)(text("Hidden:"),        signalText_(detailHidden)),
    hstack(gap = 8)(text("MoE:"),           signalText_(detailExperts)),
    hstack(gap = 8)(text("Size:"),          signalText_(detailGib)),
    hstack(gap = 8)(text("Resident:"),      signalText_(detailResidentTxt)),
    hstack(gap = 8)(text("Notes:"),         signalText_(detailNotes))
  )
)

```

## Compose + serve
```scalascript
val view = vstack(gap = 0)(
  router(mode, [
    route("home",     [dashboard]),
    route("chat",     [chatBody]),
    route("agents",   [agentsBody]),
    route("coders",   [codersBody]),
    route("sessions", [sessionsBody])
  ]),
  detailModal
)

serve(lower(view, darkTheme), 8410)
```
