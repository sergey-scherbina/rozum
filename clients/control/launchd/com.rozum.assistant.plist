<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The Qwen participant POOL: supervises one `meetings participant` per room — the primary
  room `assistant` (private chat) plus every room in the Telegram group registry
  (~/.local/state/rozum/messenger-groups/telegram.json). Reconciles every few seconds, so when
  the operator connects/disconnects a group from inside the bot (/addgroup, /removegroup) the
  matching Qwen spawns/stops automatically; crashed children respawn. Replaces the old
  per-room services (com.rozum.assistant + com.rozum.assistant-group).

  Each room gets its OWN ACL roster (messenger-acl/<room>.json) — a grant in one group does not
  apply in another or in the private chat. Shared resident gateway :8089 (one model load),
  shared sandbox ~/rozum-sandbox, confined shell (network allowed; deny with --shell-no-network).
  Specs: docs/specs/assistant-sandbox-tools.md, docs/specs/messenger-access-control.md.
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.rozum.assistant</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/sergiy/.cargo/bin/rozum-gateway</string>
    <string>meetings</string>
    <string>participant-pool</string>
    <string>--model</string>
    <string>mlx-community:Qwen3.5-4B-MLX-4bit</string>
    <string>--room</string>
    <string>assistant</string>
    <string>--as</string>
    <string>qwen</string>
    <string>--reply-policy</string>
    <string>always</string>
    <string>--gateway-url</string>
    <string>http://127.0.0.1:8089/v1</string>
    <string>--sandbox</string>
    <string>/Users/sergiy/rozum-sandbox</string>
    <string>--shell</string>
    <string>--persona</string>
    <string>Тебя (модель Qwen) обслуживает локальный проект rozum на Mac пользователя; тебе пишут из Telegram (личный чат или группа). ВНИМАНИЕ О НАЗВАНИИ: проект называется «rozum» (по-русски «Розум», значит «разум»); это НЕ аббревиатура — НИКОГДА не расшифровывай его как «RUM», «Reasoning Unit Model» или подобное и НЕ связывай с Google, это грубая ошибка; если такое встретится в истории — игнорируй. Пиши название только как «rozum» или «Розум». rozum — это local-first система пользователя для запуска LLM и ИИ-агентов на своём железе (Apple Silicon / MLX): локальный OpenAI/Anthropic-совместимый гейтвей для MLX и GGUF моделей; комнаты-встречи, где ИИ-агенты и люди координируются; телефонный контрол-центр (UCC); безопасная резидентность нескольких моделей (контроль допуска памяти). Отвечай кратко и по делу, на языке пользователя.</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>/Users/sergiy</string>
    <key>PATH</key><string>/Users/sergiy/.cargo/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>WorkingDirectory</key><string>/Users/sergiy/work/my/rozum</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/Users/sergiy/.rozum-assistant.log</string>
  <key>StandardErrorPath</key><string>/Users/sergiy/.rozum-assistant.log</string>
</dict>
</plist>
