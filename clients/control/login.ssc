#!/usr/bin/env ssc
---
name: rozum-ucc-login
version: 1.0.0
description: rozum UCC — Face ID / busi SSO login page. Compiled to login.html.
---
# rozum control — login

Generates the Face ID (WebAuthn) login page served by control-serve.
Compiled via: ssc run login.ssc → curl → login.html  (see deploy-ucc-web.sh)

## Setup
[route, serve](std/http.ssc)

## Page
```scalascript
val css = "html,body{margin:0;height:100%;background:radial-gradient(130% 95% at 50% 36%,transparent 50%,rgba(2,3,7,.62) 100%),radial-gradient(135% 85% at 50% -12%,#163a50 0%,#0b1d2c 32%,#06090f 68%,#05070c 100%),radial-gradient(58% 48% at 16% 6%,rgba(44,84,120,.34),transparent 62%),radial-gradient(52% 44% at 88% 20%,rgba(74,46,104,.26),transparent 60%) fixed;color:#e6e6e6;font:15px -apple-system,system-ui,sans-serif;display:flex;align-items:center;justify-content:center}.card{background:#0d1420;border:1px solid #232a36;border-radius:16px;padding:28px;max-width:380px;width:86%;text-align:center}h1{font-size:20px;margin:0 0 6px}p{color:#8a93a0;font-size:14px;margin:6px 0 20px}button{width:100%;background:#4f8ef7;color:#fff;border:0;border-radius:11px;padding:14px;font-size:16px;font-weight:600}#msg{margin-top:14px;font-size:13px;min-height:18px}.err{color:#f0a868}.ok{color:#6ee7a8}a{color:#7ab8ff;text-decoration:none;font-size:13px}"

val webauthnJs = """
const { startRegistration, startAuthentication } = SimpleWebAuthnBrowser;
const go = document.getElementById('go'), msg = document.getElementById('msg');
const j = (r) => r.json();
function note(t, cls){ msg.textContent = t; msg.className = cls || ''; }
async function post(url, body){ return fetch(url, { method:'POST', credentials:'include',
  headers: body ? {'Content-Type':'application/json'} : {}, body: body ? JSON.stringify(body) : undefined }); }
// ?token=… carries either the one-shot first-registration bootstrap token (ucc-tofu-bootstrap-token)
// or an admin-issued invite token — both are the same `invite` field server-side.
const inviteToken = new URLSearchParams(location.search).get('token') || undefined;
let mode = 'login';
(async () => {
  try {
    const s = await fetch('/control/auth/status', { credentials:'include' }).then(j);
    if (s.authed) { location.href = '/'; return; }
    if (!s.webauthn_ok) { note('WebAuthn не инициализирован (нужен HTTPS + RP ID).', 'err'); go.disabled = true; return; }
    mode = s.has_credential ? 'login' : 'register';
    if (mode === 'register' && !inviteToken) { note('Нужна ссылка с токеном — см. лог сервера (bootstrap token) или пригласительную ссылку от администратора.', 'err'); }
    go.textContent = mode === 'login' ? '🙂 Войти по Face ID' : '🙂 Создать вход (Face ID)';
  } catch (e) { note('сервер недоступен: ' + e, 'err'); }
})();
go.onclick = async () => {
  go.disabled = true; note('…');
  try {
    if (mode === 'register') {
      const opts = await post('/control/auth/register/begin', inviteToken ? { invite: inviteToken } : undefined).then(j);
      const att = await startRegistration({ optionsJSON: opts.publicKey });
      const r = await post('/control/auth/register/finish', att);
      if (!r.ok) throw new Error(await r.text());
      note('Face ID создан — теперь войдите.', 'ok');
      mode = 'login'; go.textContent = '🙂 Войти по Face ID';
    } else {
      const opts = await post('/control/auth/login/begin').then(j);
      const asse = await startAuthentication({ optionsJSON: opts.publicKey });
      const r = await post('/control/auth/login/finish', asse);
      if (!r.ok) throw new Error(await r.text());
      note('вход выполнен ✓', 'ok');
      setTimeout(() => location.href = '/', 400);
    }
  } catch (e) { note('не удалось: ' + (e.message || e), 'err'); }
  go.disabled = false;
};
"""

val html = "<!doctype html><html lang=\"ru\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\"><meta name=\"apple-mobile-web-app-capable\" content=\"yes\"><title>rozum · вход</title><style>" + css + "</style></head><body><div class=\"card\"><h1>🔐 rozum control</h1><p>Вход по Face ID (пасскей) для управления агентами.</p><button id=\"go\">…</button><div id=\"msg\"></div></div><script src=\"https://cdn.jsdelivr.net/npm/@simplewebauthn/browser@13.1.0/dist/bundle/index.umd.min.js\"></script><script>" + webauthnJs + "</script></body></html>"

route("GET", "/") { req => html }
serve(8421)
```
