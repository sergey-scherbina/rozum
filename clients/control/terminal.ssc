#!/usr/bin/env ssc
---
name: rozum-ucc-terminal
version: 1.0.0
description: rozum UCC — xterm.js terminal page. Compiled to terminal.html.
---
# rozum control — terminal

Generates the xterm.js WebSocket terminal page served by control-serve.
Compiled via: ssc run terminal.ssc → curl → terminal.html  (see deploy-ucc-web.sh)

## Setup
[route, serve](std/http.ssc)

## Page
```scalascript
val barCss = "#bar{display:flex;gap:10px;align-items:center;padding:8px max(10px,env(safe-area-inset-right)) 8px max(10px,env(safe-area-inset-left));background:#151a23;border-bottom:1px solid #232a36}#bar a{color:#7ab8ff;text-decoration:none}#st{margin-left:auto;font-size:12px;color:#8a93a0}#term{height:calc(100% - 38px);padding:4px}"
val bodyCss = "html,body{margin:0;height:100%;background:radial-gradient(130% 95% at 50% 36%,transparent 50%,rgba(2,3,7,.62) 100%),radial-gradient(135% 85% at 50% -12%,#163a50 0%,#0b1d2c 32%,#06090f 68%,#05070c 100%),radial-gradient(58% 48% at 16% 6%,rgba(44,84,120,.34),transparent 62%),radial-gradient(52% 44% at 88% 20%,rgba(74,46,104,.26),transparent 60%) fixed;color:#e6e6e6;font:14px -apple-system,system-ui,sans-serif}"

val xtermJs = """
// i18n
var _LG=localStorage.getItem('rozum_lang')||navigator.language.split('-')[0]||'en';
var _LT={'ru':{'← UCC':'← UCC','no session id':'нет id сессии','No session id. Open terminal from the UCC sessions list.':'Нет id сессии. Откройте терминал из списка сессий UCC.','connecting…':'подключение…','● connected':'● подключено','○ disconnected — reconnect?':'○ отключено — переподключиться?','○ reconnecting…':'○ переподключение…','✗ error (Face ID login required?)':'✗ ошибка (нужен вход по Face ID?)','rozum · terminal':'rozum · терминал'},'uk':{'← UCC':'← UCC','no session id':'немає id сесії','No session id. Open terminal from the UCC sessions list.':'Немає id сесії. Відкрийте термінал зі списку сесій UCC.','connecting…':'підключення…','● connected':'● підключено','○ disconnected — reconnect?':'○ відключено — перепідключитися?','○ reconnecting…':'○ перепідключення…','✗ error (Face ID login required?)':'✗ помилка (потрібен вхід через Face ID?)','rozum · terminal':'rozum · термінал'}};
function _lt(s){var m=_LT[_LG];return(m&&m[s])||s;}
document.documentElement.lang=_LG;
if(_LT[_LG]&&_LT[_LG]['rozum · terminal'])document.title=_LT[_LG]['rozum · terminal'];
(function(){var d=document.createElement('div');d.id='rozum-lang';['en','ru','uk'].forEach(function(l){var b=document.createElement('button');b.className='rl-btn';b.textContent=l.toUpperCase();b.dataset.lang=l;b.onclick=function(){localStorage.setItem('rozum_lang',l);location.reload();};if(l===_LG)b.classList.add('active');d.appendChild(b);});document.body.appendChild(d);})();
const id = new URLSearchParams(location.search).get('id') || '';
document.getElementById('sid').textContent = id || _lt('no session id');
const st = document.getElementById('st');
const term = new Terminal({ cursorBlink:true, fontSize:13, theme:{ background:'#0b0e14' } });
const fit = new FitAddon.FitAddon();
term.loadAddon(fit);
term.open(document.getElementById('term'));
fit.fit();
const wsUrl = (location.protocol === 'https:' ? 'wss://' : 'ws://') + location.host + '/control/session/attach/' + encodeURIComponent(id);
let ws;
let retries = 0;
function connect(){
  if (!id) { st.textContent = '✗ ' + _lt('no session id'); term.writeln(_lt('No session id. Open terminal from the UCC sessions list.')); return; }
  st.textContent = _lt('connecting…');
  ws = new WebSocket(wsUrl);
  ws.binaryType = 'arraybuffer';
  ws.onopen = () => { retries = 0; st.textContent = _lt('● connected'); sendResize(); term.focus(); };
  ws.onmessage = (e) => { term.write(typeof e.data === 'string' ? e.data : new Uint8Array(e.data)); };
  ws.onclose = () => {
    // Auto-retry: the session may still be warming up (attach 404s until tmux exists after a
    // control-serve restart) or the network blipped. ~3 min of retries, then manual.
    if (retries < 60) { retries++; st.textContent = _lt('○ reconnecting…') + ' (' + retries + ')'; setTimeout(connect, 3000); }
    else { st.textContent = _lt('○ disconnected — reconnect?'); }
  };
  ws.onerror = () => { st.textContent = _lt('✗ error (Face ID login required?)'); };
}
function sendResize(){ if (ws && ws.readyState === 1) ws.send(JSON.stringify({ resize:{ cols: term.cols, rows: term.rows } })); }
term.onData(d => { if (ws && ws.readyState === 1) ws.send(d); });
window.addEventListener('resize', () => { fit.fit(); sendResize(); });
st.onclick = () => { if (!ws || ws.readyState > 1) connect(); };
if (id) connect(); else { st.textContent = '✗ ' + _lt('no session id'); term.writeln(_lt('No session id. Open terminal from the UCC sessions list.')); }
"""

val langCss = "#rozum-lang{position:fixed;bottom:16px;right:16px;display:flex;gap:1px;z-index:999;box-shadow:0 2px 8px rgba(0,0,0,.5)}.rl-btn{background:#21262d;color:#6e7681;border:1px solid #30363d;padding:4px 8px;cursor:pointer;font-size:11px;font-weight:600;letter-spacing:.03em}.rl-btn:first-child{border-radius:5px 0 0 5px}.rl-btn:last-child{border-radius:0 5px 5px 0}.rl-btn.active{background:#1f3a28;border-color:#2ea043;color:#56d364}"

val xtermCdn = "https://cdn.jsdelivr.net/npm/@xterm/xterm@5.5.0"
val fitCdn   = "https://cdn.jsdelivr.net/npm/@xterm/addon-fit@0.10.0"

val html = "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,maximum-scale=1,viewport-fit=cover\"><meta name=\"apple-mobile-web-app-capable\" content=\"yes\"><title>rozum · terminal</title><link rel=\"stylesheet\" href=\"" + xtermCdn + "/css/xterm.min.css\"><style>" + bodyCss + barCss + langCss + "</style></head><body><div id=\"bar\"><a href=\"/\">← UCC</a><b id=\"sid\"></b><span id=\"st\">…</span></div><div id=\"term\"></div><script src=\"" + xtermCdn + "/lib/xterm.min.js\"></script><script src=\"" + fitCdn + "/lib/addon-fit.min.js\"></script><script>" + xtermJs + "</script></body></html>"

route("GET", "/") { req => html }
serve(8422)
```
