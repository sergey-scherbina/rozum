#!/usr/bin/env ssc
---
name: rozum-control-center
version: 0.4.0
description: rozum UCC — ONE std/ui app -> web (React) AND terminal (ratatui). Live via /control/status.
frontend: react
---
# rozum — control center

One `std/ui` app that compiles to **both** web (React SPA) and **TUI** (ratatui),
selected only by the frontend backend (`frontend: react` / `--frontend tui`).
No web-specific `serve(...)` in the source — the runner auto-runs `def view()`.

Live snapshot from ONE `fetchUrlSignal` GET `/control/status`: residency parsed
client-side (`jsonValue` + `computedSignal`, GiB-formatted) and the installed
catalog rendered from the nested `.installed` field via `remoteTable(..., "installed")`.

## Setup
[signal, fetchUrlSignal, incSignal, computedSignal, fieldColumn](std/ui/primitives.ssc)
[jsonValue](std/json.ssc)
[lower](std/ui/lower.ssc)
[defaultTheme](std/ui/theme.ssc)
[vstack, hstack, divider](std/ui/layout.ssc)
[heading, text](std/ui/typography.ssc)
[badge](std/ui/display.ssc)
[card, cardWithHeader](std/ui/containers.ssc)
[signalText_](std/ui/reactive.ssc)
[signalActionButton](std/ui/input.ssc)
[remoteTable](std/ui/data.ssc)

## App
```scalascript
val refresh = signal("refresh", 0)
val st      = fetchUrlSignal("status", "/control/status", refresh)

def gib(b: Double): String = {
  val t = (b / 107374182.4).toInt
  (t / 10).toString + "." + (t % 10).toString + " GiB"
}
val availTxt     = computedSignal(() => gib(jsonValue(st()).get("residency").get("available_bytes").asDouble))
val budgetTxt    = computedSignal(() => gib(jsonValue(st()).get("residency").get("host_budget_bytes").asDouble))
val committedTxt = computedSignal(() => gib(jsonValue(st()).get("residency").get("committed_bytes").asDouble))

val gwCard = cardWithHeader(heading(2, "Gateway / residency"))(
  vstack(gap = 6)(
    hstack(gap = 8)(
      text("source:"), badge("rozum control-API (always-up)", "success"),
      signalActionButton(incSignal(refresh), "↻ refresh")
    ),
    hstack(gap = 8)(text("available:"),   signalText_(availTxt)),
    hstack(gap = 8)(text("host budget:"), signalText_(budgetTxt)),
    hstack(gap = 8)(text("committed:"),   signalText_(committedTxt))
  )
)

val catCard = cardWithHeader(heading(2, "Installed catalog"))(
  remoteTable(
    st,
    [fieldColumn("Model", "spec"), fieldColumn("Size (bytes)", "size_bytes")],
    "installed"
  )
)

val meetingsCard = cardWithHeader(heading(2, "Meetings — room: rozum"))(
  vstack(gap = 6)(
    hstack(gap = 8)(text("sunny-civet"),  badge("agent", "success")),
    hstack(gap = 8)(text("nimble-raven"), badge("agent", "success")),
    hstack(gap = 8)(text("plucky-finch"), badge("agent", "success")),
    hstack(gap = 8)(text("plucky-fox"),   badge("agent", "success")),
    hstack(gap = 8)(text("Sergiy"),       badge("operator", "neutral"))
  )
)

def view() = lower(
  vstack(gap = 16)(
    heading(1, "rozum — control center"),
    text("ONE .ssc -> web + TUI — live models/gateway/residency via the rozum control-API"),
    divider(),
    gwCard,
    divider(),
    catCard,
    divider(),
    meetingsCard
  ),
  defaultTheme
)
```
