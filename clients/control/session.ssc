#!/usr/bin/env ssc
---
name: rozum-ucc-session
version: 1.0.0
description: rozum UCC — chat-style agent session page. Compiled to session.html.
---
# rozum control — session (chat)

A CHAT-style view of an interactive agent session — an input field, a send button, and the
history above — instead of the raw xterm.js terminal. It polls `/control/session/output` (clean
`tmux capture-pane` text, no escape sequences) and posts lines to `/control/session/send`, so it
carries none of the PTY / terminal-probe garbage the raw attach fought.

Compiled via: ssc run session.ssc → session.html  (see deploy-ucc-web.sh)

## Page
```scalascript
val bodyCss = "html,body{margin:0;height:100%;background:radial-gradient(130% 95% at 50% 36%,transparent 50%,rgba(2,3,7,.62) 100%),radial-gradient(135% 85% at 50% -12%,#163a50 0%,#0b1d2c 32%,#06090f 68%,#05070c 100%),radial-gradient(58% 48% at 16% 6%,rgba(44,84,120,.34),transparent 62%),radial-gradient(52% 44% at 88% 20%,rgba(74,46,104,.26),transparent 60%) fixed;color:#e6e6e6;font:14px -apple-system,system-ui,sans-serif}"

val css = "#app{display:flex;flex-direction:column;height:100dvh}#bar{display:flex;gap:10px;align-items:center;padding:8px max(10px,env(safe-area-inset-right)) 8px max(10px,env(safe-area-inset-left));background:#151a23;border-bottom:1px solid #232a36;flex:0 0 auto}#bar a{color:#7ab8ff;text-decoration:none}#bar b{font-size:13px;color:#c9d4e3;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}#st{margin-left:auto;font-size:12px;color:#8a93a0;flex:0 0 auto}#out{flex:1 1 auto;margin:0;padding:10px max(10px,env(safe-area-inset-right)) 10px max(10px,env(safe-area-inset-left));overflow-y:auto;-webkit-overflow-scrolling:touch;white-space:pre-wrap;word-break:break-word;font:13px/1.45 ui-monospace,SFMono-Regular,Menlo,monospace;color:#d7dee8;background:#0b0e14}#keys{display:flex;gap:6px;padding:6px max(10px,env(safe-area-inset-right)) 0 max(10px,env(safe-area-inset-left));background:#10141c;overflow-x:auto;-webkit-overflow-scrolling:touch;flex:0 0 auto}#keys button{flex:0 0 auto;min-width:42px;padding:6px 10px;background:#1c2330;color:#c9d4e3;border:1px solid #2c3648;border-radius:7px;font:13px -apple-system,system-ui,sans-serif;cursor:pointer}#keys button:active{background:#2a3850}#composer{display:flex;gap:8px;padding:8px max(10px,env(safe-area-inset-right)) max(8px,env(safe-area-inset-bottom)) max(10px,env(safe-area-inset-left));background:#10141c;border-top:1px solid #232a36;flex:0 0 auto}#inp{flex:1 1 auto;min-width:0;padding:10px 12px;background:#0b0e14;color:#e6e6e6;border:1px solid #2c3648;border-radius:9px;font-size:16px;font-family:-apple-system,system-ui,sans-serif;resize:none}#send{flex:0 0 auto;padding:0 16px;background:#1f3a28;color:#56d364;border:1px solid #2ea043;border-radius:9px;font-size:15px;font-weight:600;cursor:pointer}#send:active{background:#2a4d34}#send:disabled{opacity:.5}"

val js = """
var _LG=localStorage.getItem('rozum_lang')||navigator.language.split('-')[0]||'en';
var _LT={'ru':{'← UCC':'← UCC','no session id':'нет id сессии','No session id. Open a session from the UCC sessions list.':'Нет id сессии. Откройте сессию из списка сессий UCC.','message…':'сообщение…','send':'отпр.','● live':'● на связи','○ ended':'○ завершена','✗ error':'✗ ошибка','rozum · session':'rozum · сессия','(no output yet)':'(вывода пока нет)'},'uk':{'← UCC':'← UCC','no session id':'немає id сесії','No session id. Open a session from the UCC sessions list.':'Немає id сесії. Відкрийте сесію зі списку сесій UCC.','message…':'повідомлення…','send':'надісл.','● live':'● на зв’язку','○ ended':'○ завершена','✗ error':'✗ помилка','rozum · session':'rozum · сесія','(no output yet)':'(виводу поки немає)'}};
function _lt(s){var m=_LT[_LG];return(m&&m[s])||s;}
document.documentElement.lang=_LG;
if(_LT[_LG]&&_LT[_LG]['rozum · session'])document.title=_LT[_LG]['rozum · session'];
(function(){var d=document.createElement('div');d.id='rozum-lang';['en','ru','uk'].forEach(function(l){var b=document.createElement('button');b.className='rl-btn';b.textContent=l.toUpperCase();b.dataset.lang=l;b.onclick=function(){localStorage.setItem('rozum_lang',l);location.reload();};if(l===_LG)b.classList.add('active');d.appendChild(b);});document.body.appendChild(d);})();

var id=new URLSearchParams(location.search).get('id')||'';
var out=document.getElementById('out'), st=document.getElementById('st'), inp=document.getElementById('inp'), send=document.getElementById('send');
document.getElementById('sid').textContent=id||_lt('no session id');
inp.placeholder=_lt('message…'); send.textContent=_lt('send');

function atBottom(){ return out.scrollHeight-out.scrollTop-out.clientHeight < 40; }
function scrollDown(){ out.scrollTop=out.scrollHeight; }
var lastText='';
function apply(text){
  if(text===lastText) return;
  var stick=atBottom();
  lastText=text;
  out.textContent = text.length? text : _lt('(no output yet)');
  if(stick) scrollDown();
}
var polling=false;
function poll(){
  if(polling||!id) return; polling=true;
  fetch('/control/session/output?id='+encodeURIComponent(id),{headers:{}})
    .then(function(r){ if(r.status===401){location.href='/login.html';throw 0;} return r.json(); })
    .then(function(j){ apply(j.output||''); st.textContent=j.alive? _lt('● live'):_lt('○ ended'); })
    .catch(function(e){ if(e!==0) st.textContent=_lt('✗ error'); })
    .then(function(){ polling=false; });
}
function post(bodyObj){
  return fetch('/control/session/send',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(bodyObj)})
    .then(function(r){ if(r.status===401){location.href='/login.html';throw 0;} return r.json(); });
}
function doSend(){
  var v=inp.value;
  if(!id||!v) { inp.focus(); return; }
  send.disabled=true;
  post({id:id,input:v,submit:true})
    .then(function(){ inp.value=''; })
    .catch(function(){})
    .then(function(){ send.disabled=false; inp.focus(); scrollDown();
      // a couple of quick follow-up polls so the echo + first output appear promptly
      setTimeout(poll,250); setTimeout(poll,900); setTimeout(poll,1800); });
}
send.addEventListener('click',doSend);
// Enter sends; Shift+Enter / newline stays a newline in the field (for multi-line prompts).
inp.addEventListener('keydown',function(e){ if(e.key==='Enter'&&!e.shiftKey){ e.preventDefault(); doSend(); } });

// Control keys interactive agents need but the chat field can't type (whitelisted server-side).
var KEYS=[['⏎','Enter'],['Esc','Escape'],['Tab','Tab'],['^C','C-c'],['^U','C-u'],['^D','C-d']];
var kbar=document.getElementById('keys');
KEYS.forEach(function(k){ var b=document.createElement('button'); b.type='button'; b.textContent=k[0];
  var fire=function(e){ e.preventDefault(); if(id) post({id:id,input:'',keys:[k[1]]}).then(function(){ setTimeout(poll,250); setTimeout(poll,900); }).catch(function(){}); };
  b.addEventListener('touchstart',fire,{passive:false}); b.addEventListener('mousedown',fire); kbar.appendChild(b);
});

if(!id){ st.textContent='✗ '+_lt('no session id'); out.textContent=_lt('No session id. Open a session from the UCC sessions list.'); }
else { poll(); setInterval(poll,1500); }
"""

val langCss = "#rozum-lang{position:fixed;top:8px;right:96px;display:flex;gap:1px;z-index:999}.rl-btn{background:#21262d;color:#6e7681;border:1px solid #30363d;padding:3px 7px;cursor:pointer;font-size:10px;font-weight:600;letter-spacing:.03em}.rl-btn:first-child{border-radius:5px 0 0 5px}.rl-btn:last-child{border-radius:0 5px 5px 0}.rl-btn.active{background:#1f3a28;border-color:#2ea043;color:#56d364}"

val html = "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,maximum-scale=1,viewport-fit=cover\"><meta name=\"apple-mobile-web-app-capable\" content=\"yes\"><title>rozum · session</title><style>" + bodyCss + css + langCss + "</style></head><body><div id=\"app\"><div id=\"bar\"><a href=\"/\">← UCC</a><b id=\"sid\"></b><span id=\"st\">…</span></div><pre id=\"out\"></pre><div id=\"keys\"></div><div id=\"composer\"><input id=\"inp\" autocomplete=\"off\" autocapitalize=\"off\" autocorrect=\"off\"><button id=\"send\" type=\"button\">send</button></div></div><script>" + js + "</script></body></html>"

// Static page: printed to stdout for the deploy to capture (control-serve serves the file).
println(html)
```
