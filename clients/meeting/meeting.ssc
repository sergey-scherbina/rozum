[route, serve](std/http.ssc)
[readFile, listDir, isDir](std/fs.ssc)
[exec, ProcessOptions](std/process.ssc)
[renderHtml, element, textNode](std/ui/primitives.ssc)
```scalascript
val palette  = ["#6ee7a8", "#7ab8ff", "#f0a868", "#c79bff", "#ff9ec4", "#5fd3c8", "#e6d264", "#9fd0ff"]
val delPy = "import json,os,sys,shutil\nbase=os.environ.get('XDG_STATE_HOME') or os.path.join(os.path.expanduser('~'),'.local','state')\np=os.path.join(base,'rozum','rooms.json')\nif not os.path.exists(p): sys.exit(0)\nn=sys.argv[1]\nd=json.load(open(p))\nR=d if isinstance(d,list) else d.get('rooms',[])\n[shutil.rmtree(r['root'],ignore_errors=True) for r in R if r.get('name')==n and not r.get('project') and r.get('root')]\nN=[r for r in R if not (r.get('name')==n and not r.get('project'))]\njson.dump(N if isinstance(d,list) else dict(d,rooms=N), open(p,'w'))"
val cleanPy = "import json,os,sys,shutil,glob\nbase=os.environ.get('XDG_STATE_HOME') or os.path.join(os.path.expanduser('~'),'.local','state')\np=os.path.join(base,'rozum','rooms.json')\nif not os.path.exists(p): sys.exit(0)\nd=json.load(open(p))\nR=d if isinstance(d,list) else d.get('rooms',[])\ndef emp(r):\n root=r.get('root')\n if not root or not os.path.isdir(root): return True\n return not any(os.path.getsize(f)>0 for f in glob.glob(root+'/*.jsonl'))\n[shutil.rmtree(r['root'],ignore_errors=True) for r in R if (not r.get('project')) and emp(r) and r.get('root')]\nK=[r for r in R if r.get('project') or not emp(r)]\njson.dump(K if isinstance(d,list) else dict(d,rooms=K), open(p,'w'))"

def stateRoot(): String =
  exec("sh", ["-c", "printf '%s' \"${XDG_STATE_HOME:-$HOME/.local/state}/rozum\""], ProcessOptions(None, Map(), None)).stdout.trim

def roomsDir(): String =
  s"${stateRoot()}/rooms"

def statusOut(): String =
  exec("rozum", ["meetings", "status"], ProcessOptions(None, Map(), None)).stdout

def roomLineName(l: String): String =
  val a = l.split("project:")
  a(0).trim

def projOf(l: String): String =
  val a = l.split("project:")
  if a.length < 2 then "-" else a(1).trim

def roomNames(): List[String] =
  val lines = roomStatusLines()
  if lines.length < 1 then ["demo"] else lines.map(l => roomLineName(l)).toList

def roomStatusLines(): List[String] =
  statusOut().split("\n").filter(l => l.contains("project:")).toList

def roomStatusLine(name: String): String =
  firstRoomStatusLine(roomStatusLines(), name)

def firstRoomStatusLine(lines: List[String], name: String): String =
  if lines.length < 1 then "" else
    val line = lines(0) + ""
    if roomLineName(line + "") == name then line
    else firstRoomStatusLine(lines.drop(1).toList, name)

def afterPrefix(p: String): String =
  val parts = p.split("/")
  val last  = parts(parts.length - 1) + ""
  if last == "" then "demo" else last

def firstLine(s: String): String =
  val b = s.split("\n")
  b(0).trim

def roomDir(name: String): String =
  val line = roomStatusLine(name)
  if line != "" then
    val proj = projOf(line)
    if proj == "-" then s"${roomsDir()}/$name" else s"$proj/.rozum/room"
  else
    s"${roomsDir()}/$name"

def readRoom(name: String): String =
  val dir = roomDir(name)
  if isDir(dir) then
    val files = listDir(dir).filter(f => f.contains(".jsonl")).sorted
    files.map(f => readFile(s"$dir/$f")).toList.join("\n")
  else ""

def who(line: String): String =
  val parts = line.split("\"display_name\":\"")
  if parts.length < 2 then "" else
    val bits = parts(1).split("\"")
    bits(0) + ""

def msg(line: String): String =
  val parts = line.split("\"content\":\"")
  if parts.length < 2 then "" else
    val bits = parts(1).split("\",\"ts\":")
    bits(0).replace("\\\"", "\"")

def handleOf(name: String): String =
  val bits = name.split(" · ")
  if bits.length < 2 then name else bits(1) + ""

def hashStr(s: String): Int =
  s.trim.toList.map(c => c.toInt).sum

def roleColor(name: String): String =
  val idx = hashStr(handleOf(name)) % 8
  palette(idx) + ""

def pad2(n: Int): String =
  if n < 10 then s"0$n" else n.toString

def tsOf(line: String): String =
  val a = line.split("\"ts\":")
  if a.length < 2 then "" else
    val raw  = a(1).split("}")
    val secs = raw(0).trim.toInt + 7200
    s"${pad2((secs % 86400) / 3600)}:${pad2((secs % 3600) / 60)}"

def linkify(s: String): View =
  if s.contains("http") then
    val words = s.split(" ")
    val spans = words.map(w =>
      if w.startsWith("http") then element("a", ["href" -> (w + ""), "target" -> "_blank", "style" -> "color:#7ab8ff"], Map(), [textNode(w + " ")])
      else element("span", Map(), Map(), [textNode(w + " ")])
    ).toList
    element("span", Map(), Map(), spans)
  else element("span", Map(), Map(), [textNode(s)])

def boldify(s: String): View =
  val parts = s.split("**")
  val n = parts.length
  val spans = (0 until n).map(i =>
    if i % 2 == 1 then element("b", Map(), Map(), [textNode(parts(i) + "")])
    else linkify(parts(i) + "")
  ).toList
  element("span", Map(), Map(), spans)

def renderContent(c: String): View =
  val parts = c.split("`")
  val n = parts.length
  val spans = (0 until n).map(i =>
    if i % 2 == 1 then element("code", ["style" -> "font-family:ui-monospace,Menlo,monospace; font-size:0.9em; background:#23272e; padding:1px 5px; border-radius:5px"], Map(), [textNode(parts(i) + "")])
    else boldify(parts(i) + "")
  ).toList
  element("span", Map(), Map(), spans)

def badge(label: String, color: String): View =
  element("span", ["style" -> ("background:" + color + "; color:#fff; font-size:11px; font-weight:700; padding:1px 6px; border-radius:5px; margin-right:5px")], Map(), [textNode(label)])

def afterColon(c: String): String =
  val parts = c.split(": ")
  if parts.length < 2 then c else
    val rest = parts.drop(1)
    rest.join(": ")

def contentView(c: String): View =
  if c.startsWith("done: ") then
    element("span", Map(), Map(), [badge("done", "#2e7d4f"), renderContent(afterColon(c))])
  else if c.startsWith("working: ") then
    element("span", Map(), Map(), [badge("working", "#2f6feb"), renderContent(afterColon(c))])
  else if c.startsWith("blocked: ") then
    element("span", Map(), Map(), [badge("blocked", "#b3431f"), renderContent(afterColon(c))])
  else renderContent(c)

def row(line: String): View =
  val w = who(line)
  element("div", ["style" -> "margin:0 0 9px; overflow-wrap:anywhere"], Map(), [
    element("span", ["style" -> "color:#5b626d; font-size:12px; margin-right:6px"], Map(), [textNode(tsOf(line))]),
    element("span", ["style" -> ("color:" + roleColor(w) + "; font-weight:600; margin-right:6px")], Map(), [textNode(w)]),
    contentView(msg(line))
  ])

def dateOf(line: String): String =
  val a = line.split("\"date\":\"")
  if a.length < 2 then "" else
    val b = a(1).split("\"")
    b(0) + ""

def dateDivider(d: String): View =
  element("div", ["style" -> "text-align:center; color:#6b7280; font-size:12px; margin:16px 0 9px"], Map(), [textNode(d)])

def msgsView(cur: String): View =
  val all   = readRoom(cur).split("\n").filter(l => l.contains("\"content\":\""))
  val cnt   = all.length
  val lines = all.takeRight(80).toList
  val n     = lines.length
  val rows  = (0 until n).map(i =>
    val ln       = lines(i) + ""
    val curDate  = dateOf(ln)
    val prevDate = if i < 1 then "" else dateOf(lines(i - 1) + "")
    if curDate == prevDate then row(ln)
    else element("div", Map(), Map(), [dateDivider(curDate), row(ln)])
  ).toList
  val body  = if cnt < 1 then [element("div", ["style" -> "color:#5b626d; text-align:center; padding:28px 0"], Map(), [textNode("пока пусто — напиши первым")])] else rows
  element("div", ["id" -> "msgs"], Map(), body)

def tab(cur: String, name: String): View =
  val on = if name == cur then "background:#2f6feb; color:#fff" else "background:#1b1e24; color:#9ad"
  element("a", ["href" -> ("/r/" + name), "style" -> ("padding:6px 12px; margin-right:8px; border-radius:7px; text-decoration:none; font-weight:600; " + on)], Map(), [textNode(name)])

val script = "<script>if('serviceWorker' in navigator){navigator.serviceWorker.getRegistrations().then(function(rs){rs.forEach(function(r){r.unregister()})})}if(window.caches){caches.keys().then(function(ks){ks.forEach(function(k){caches.delete(k)})})}var R=location.pathname.split('/').pop()||'demo';var inp,L;function tick(){var nb=L?(L.scrollHeight-L.scrollTop-L.clientHeight<90):false;return fetch('/m/'+R).then(function(r){return r.text()}).then(function(t){var m=document.getElementById('msgs');if(m){m.outerHTML=t}if(nb&&L){L.scrollTop=L.scrollHeight}}).catch(function(e){})}function bot(){if(L){L.scrollTop=L.scrollHeight}}function syncH(){var a=document.getElementById('app');if(a&&window.visualViewport){a.style.height=window.visualViewport.height+'px'}}window.addEventListener('load',function(){inp=document.querySelector('input');L=document.getElementById('list');var sel=document.getElementById('rs');if(sel){sel.value=R;sel.onchange=function(){location.href='/r/'+encodeURIComponent(sel.value)}}var f=document.querySelector('form');f.addEventListener('submit',function(e){e.preventDefault();var v=inp.value;if(!v)return;inp.value='';fetch('/p',{method:'POST',headers:{'Content-Type':'text/plain'},body:'room='+R+'\\ncontent='+v}).then(tick).then(bot)});setInterval(tick,2500);bot();if(window.visualViewport){window.visualViewport.addEventListener('resize',syncH);window.visualViewport.addEventListener('scroll',syncH)}syncH();var sy=0,pulling=false;L.addEventListener('touchstart',function(e){if(L.scrollTop<=0){sy=e.touches[0].clientY;pulling=true}else{pulling=false}},{passive:true});L.addEventListener('touchmove',function(e){if(!pulling)return;var dy=e.touches[0].clientY-sy;if(dy>0&&L.scrollTop<=0){e.preventDefault();var p=Math.min(dy,130);L.style.transform='translateY('+(p*0.4)+'px)'}},{passive:false});L.addEventListener('touchend',function(e){if(!pulling)return;var dy=e.changedTouches[0].clientY-sy;pulling=false;L.style.transition='transform .22s';L.style.transform='';setTimeout(function(){L.style.transition=''},240);if(dy>=72){location.reload()}},{passive:true})});</script>"

val head = "<!doctype html><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,maximum-scale=1,viewport-fit=cover\"><meta name=\"apple-mobile-web-app-capable\" content=\"yes\"><meta name=\"mobile-web-app-capable\" content=\"yes\"><meta name=\"apple-mobile-web-app-status-bar-style\" content=\"black-translucent\"><meta name=\"apple-mobile-web-app-title\" content=\"rozum\"><meta name=\"theme-color\" content=\"#14161a\"><link rel=\"manifest\" href=\"/manifest.webmanifest\"><link rel=\"icon\" type=\"image/svg+xml\" href=\"/icon.svg\"><link rel=\"apple-touch-icon\" href=\"data:image/png;base64,\"><title>rozum</title><style>*{box-sizing:border-box}html,body{margin:0;height:100%;background:#14161a;-webkit-text-size-adjust:100%;overflow:hidden}#msgs div{overflow-wrap:anywhere;word-break:break-word}</style>"

val swjs = "self.addEventListener('install',function(e){self.skipWaiting()});self.addEventListener('activate',function(e){e.waitUntil(caches.keys().then(function(ks){return Promise.all(ks.map(function(k){return caches.delete(k)}))}).then(function(){return self.registration.unregister()}).then(function(){return self.clients.matchAll({type:'window'})}).then(function(cs){cs.forEach(function(c){c.navigate(c.url)})}).catch(function(e){}))});"

val iconSvg = "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"512\" height=\"512\" viewBox=\"0 0 512 512\"><rect width=\"512\" height=\"512\" rx=\"115\" fill=\"#1b1e24\"/><path d=\"M150 128 h212 a44 44 0 0 1 44 44 v140 a44 44 0 0 1 -44 44 H252 l-78 66 v-66 h-24 a44 44 0 0 1 -44 -44 V172 a44 44 0 0 1 44 -44 z\" fill=\"#2f6feb\"/><circle cx=\"198\" cy=\"242\" r=\"22\" fill=\"#6ee7a8\"/><circle cx=\"266\" cy=\"242\" r=\"22\" fill=\"#dfeaff\"/><circle cx=\"334\" cy=\"242\" r=\"22\" fill=\"#f0a868\"/></svg>"

def serviceWorkerJs(): String = swjs + ""

def iconSvgDoc(): String = iconSvg + ""

def authorChip(name: String): View =
  element("span", ["style" -> ("color:" + roleColor(name) + "; background:#1f242c; font-size:12px; padding:2px 9px; border-radius:11px; white-space:nowrap")], Map(), [textNode(name)])

def activeView(cur: String): View =
  val all     = readRoom(cur).split("\n").filter(l => l.contains("\"content\":\""))
  val recent  = all.takeRight(25)
  val authors = recent.map(who).toList.distinct
  if authors.length < 1 then element("div", Map(), Map(), [])
  else element("div", ["style" -> "flex:0 0 auto; display:flex; gap:7px; overflow-x:auto; padding:7px max(12px,env(safe-area-inset-right)) 7px max(12px,env(safe-area-inset-left)); background:#15181d; border-bottom:1px solid #23272e; -webkit-overflow-scrolling:touch"], Map(), authors.map(authorChip).toList)

def page(cur: String): String =
  val rnames  = roomNames()
  val opts    = rnames.map(n => element("option", ["value" -> n], Map(), [textNode(n)])).toList
  val sel     = element("select", ["id" -> "rs", "style" -> "flex:1; min-width:0; padding:7px 10px; border-radius:8px; border:1px solid #333a44; background:#0f1115; color:#e6e6e6; font-size:15px"], Map(), opts)
  val mpLink  = element("a", ["href" -> ("/mp/" + cur), "style" -> "flex:0 0 auto; text-decoration:none; font-size:20px; line-height:1; padding:3px 5px"], Map(), [textNode("🤖")])
  val gear    = element("a", ["href" -> "/manage", "style" -> "flex:0 0 auto; text-decoration:none; font-size:21px; line-height:1; padding:3px 6px"], Map(), [textNode("⚙")])
  val tabsRow = element("div", ["style" -> "display:flex; gap:8px; align-items:center; width:100%"], Map(), [sel, mpLink, gear])
  val handle  = element("div", ["style" -> "width:56px; height:6px; border-radius:3px; background:#3a414d"], Map(), [])
  val nav     = element("div", ["id" -> "nav", "style" -> "flex:0 0 auto; display:flex; flex-direction:column; align-items:center; gap:9px; padding:max(8px,env(safe-area-inset-top)) max(12px,env(safe-area-inset-right)) 8px max(12px,env(safe-area-inset-left)); background:#1b1e24; border-bottom:1px solid #2a2e36"], Map(), [tabsRow, handle])
  val list  = element("div", ["id" -> "list", "style" -> "flex:1 1 auto; min-height:0; overflow-y:auto; -webkit-overflow-scrolling:touch; padding:12px max(14px,env(safe-area-inset-right)) 12px max(14px,env(safe-area-inset-left)); color:#e6e6e6; font:15px/1.5 -apple-system,system-ui,sans-serif"], Map(), [msgsView(cur)])
  val input = element("input", ["name" -> "content", "placeholder" -> "message…", "autocomplete" -> "off", "style" -> "flex:1; min-width:0; padding:10px 12px; border-radius:9px; border:1px solid #333a44; background:#0f1115; color:#e6e6e6; font-size:16px; line-height:1.2"], Map(), [])
  val send  = element("button", ["type" -> "submit", "style" -> "flex:0 0 auto; white-space:nowrap; padding:10px 16px; border:0; border-radius:9px; background:#2f6feb; color:#fff; font-weight:600"], Map(), [textNode("send")])
  val rfield = element("input", ["type" -> "hidden", "name" -> "room", "value" -> cur], Map(), [])
  val form  = element("form", ["id" -> "sb", "method" -> "post", "action" -> "/p", "enctype" -> "text/plain", "style" -> "flex:0 0 auto; display:flex; gap:8px; padding:9px max(12px,env(safe-area-inset-right)) calc(9px + env(safe-area-inset-bottom)) max(12px,env(safe-area-inset-left)); background:#1b1e24; border-top:1px solid #2a2e36"], Map(), [rfield, input, send])
  val doc   = element("div", ["id" -> "app", "style" -> "display:flex; flex-direction:column; height:100dvh; overflow:hidden; background:#14161a"], Map(), [nav, activeView(cur), list, form])
  head ++ renderHtml(doc) ++ script

def roomMsgs(cur: String): String =
  renderHtml(msgsView(cur))

def manifest(): String =
  "{\"name\":\"rozum\",\"short_name\":\"rozum\",\"start_url\":\"/r/demo\",\"display\":\"standalone\",\"background_color\":\"#14161a\",\"theme_color\":\"#14161a\",\"icons\":[{\"src\":\"/icon.svg\",\"sizes\":\"any\",\"type\":\"image/svg+xml\",\"purpose\":\"any maskable\"}]}"

def doPost(body: String): String =
  val rp = body.split("room=")
  val room = if rp.length < 2 then "demo" else firstLine(rp(1) + "")
  val cp = body.split("content=")
  val content = if cp.length < 2 then "" else firstLine(cp(1) + "")
  val r = exec("rozum", ["meetings", "post", "--room", room, content], ProcessOptions(None, Map(), None))
  "ok"

def confirmForm(act: String, key: String, value: String, label: String, color: String, confirmMsg: String): View =
  element("form", ["method" -> "post", "action" -> "/do", "enctype" -> "text/plain", "style" -> "display:inline", "onsubmit" -> ("return confirm('" + confirmMsg + "')")], Map(), [
    element("input", ["type" -> "hidden", "name" -> "act", "value" -> act], Map(), []),
    element("input", ["type" -> "hidden", "name" -> key, "value" -> value], Map(), []),
    element("button", ["style" -> ("background:" + color + "; color:#fff; border:0; border-radius:6px; padding:4px 11px; font-size:13px")], Map(), [textNode(label)])
  ])

def roomItem(l: String): View =
  val name = roomLineName(l)
  val proj = projOf(l)
  val link = element("a", ["href" -> ("/r/" + name), "style" -> "color:#7ab8ff; text-decoration:none; font-weight:600"], Map(), [textNode(name)])
  val tag  = element("span", ["style" -> "color:#5b626d; font-size:12px; margin-left:8px"], Map(), [textNode(if proj == "-" then "глобальная" else proj + "")])
  val right = if proj == "-" then confirmForm("delroom", "name", name, "удалить", "#b3431f", "Удалить комнату " + name + "?") else element("span", ["style" -> "color:#5b626d; font-size:12px"], Map(), [textNode("проект")])
  element("div", ["style" -> "display:flex; align-items:center; justify-content:space-between; gap:8px; padding:9px 0; border-bottom:1px solid #23272e"], Map(), [element("span", Map(), Map(), [link, tag]), right])

def modelItem(l: String): View =
  val sp = l.split("GB")
  val spec = if sp.length < 2 then "" else sp(1).trim
  val rm = if spec == "" then element("span", Map(), Map(), []) else confirmForm("rmmodel", "spec", spec, "удалить", "#b3431f", "Удалить модель " + spec + " (освободить диск)?")
  element("div", ["style" -> "display:flex; align-items:center; justify-content:space-between; gap:8px; padding:9px 0; border-bottom:1px solid #23272e"], Map(), [element("span", ["style" -> "font-size:13px; overflow-wrap:anywhere"], Map(), [textNode(l)]), rm])

def createForm(): View =
  element("form", ["method" -> "post", "action" -> "/do", "enctype" -> "text/plain", "style" -> "display:flex; gap:8px; margin:6px 0 12px"], Map(), [
    element("input", ["type" -> "hidden", "name" -> "act", "value" -> "createroom"], Map(), []),
    element("input", ["name" -> "name", "placeholder" -> "новая комната…", "autocomplete" -> "off", "style" -> "flex:1; min-width:0; padding:8px 10px; border-radius:8px; border:1px solid #333a44; background:#0f1115; color:#e6e6e6; font-size:16px"], Map(), []),
    element("button", ["style" -> "flex:0 0 auto; background:#2e7d4f; color:#fff; border:0; border-radius:8px; padding:8px 14px; font-weight:600"], Map(), [textNode("создать")])
  ])

def cleanForm(): View =
  element("form", ["method" -> "post", "action" -> "/do", "enctype" -> "text/plain", "style" -> "margin:0 0 12px", "onsubmit" -> "return confirm('Удалить все пустые глобальные комнаты? (проектные не тронутся)')"], Map(), [
    element("input", ["type" -> "hidden", "name" -> "act", "value" -> "cleanempty"], Map(), []),
    element("button", ["style" -> "background:#3a414d; color:#e6e6e6; border:0; border-radius:8px; padding:7px 13px; font-size:13px"], Map(), [textNode("🧹 очистить пустые")])
  ])

def agentsView(): View =
  val all     = readRoom("rozum").split("\n").filter(l => l.contains("\"content\":\""))
  val recent  = all.takeRight(30)
  val authors = recent.map(who).toList.distinct
  if authors.length < 1 then element("div", ["style" -> "color:#5b626d"], Map(), [textNode("никого")])
  else element("div", ["style" -> "display:flex; flex-wrap:wrap; gap:7px"], Map(), authors.map(authorChip).toList)

def section(title: String, body: View): View =
  element("div", ["style" -> "margin:18px 0"], Map(), [
    element("div", ["style" -> "font-size:12px; font-weight:700; color:#9ad; letter-spacing:0.05em; margin-bottom:6px"], Map(), [textNode(title)]),
    body
  ])

def gwStatus(): String =
  exec("rozum", ["gateway", "status"], ProcessOptions(None, Map(), None)).stdout

def gwModel(o: String): String =
  val a = o.split("model:")
  if a.length < 2 then "—" else firstLine(a(1) + "")

def loadBtn(l: String): View =
  val sp = l.split("GB")
  if sp.length < 2 then element("span", Map(), Map(), [])
  else
    val spec = sp(1).trim
    element("div", ["style" -> "display:flex; justify-content:space-between; align-items:center; gap:8px; padding:7px 0; border-bottom:1px solid #23272e"], Map(), [
      element("span", ["style" -> "font-size:13px; overflow-wrap:anywhere"], Map(), [textNode(spec + "")]),
      confirmForm("gwswitch", "spec", spec + "", "загрузить", "#2f6feb", "Загрузить эту модель в гейтвей?")
    ])

def gwView(): View =
  val o = gwStatus()
  val running = o.contains("running")
  val hd = if running then element("div", ["style" -> "margin-bottom:10px"], Map(), [textNode("активна: "), element("code", ["style" -> "font-family:ui-monospace,Menlo,monospace; font-size:0.9em; background:#23272e; padding:1px 5px; border-radius:5px"], Map(), [textNode(gwModel(o))])]) else element("div", ["style" -> "color:#5b626d; margin-bottom:10px"], Map(), [textNode("гейтвей не запущен")])
  val mo = exec("rozum", ["models", "list"], ProcessOptions(None, Map(), None)).stdout
  val ml = mo.split("\n").filter(l => l.contains(":")).toList
  val rows = ml.map(loadBtn).toList
  val ctl = if running then element("div", ["style" -> "display:flex; gap:8px; margin-top:12px"], Map(), [confirmForm("gwstop", "x", "1", "🛑 стоп", "#b3431f", "Остановить гейтвей?"), confirmForm("gwunload", "x", "1", "выгрузить", "#3a414d", "Выгрузить модель (демон останется)?")]) else element("span", Map(), Map(), [])
  element("div", Map(), Map(), [hd, element("div", Map(), Map(), rows), ctl])

def firstWord(s: String): String =
  val b = s.trim.split(" ")
  b(0) + ""

def modelSpec(l: String): String =
  val sp = l.split("GB")
  if sp.length < 2 then "" else sp(1).trim

def gwPort(): String =
  val o = exec("rozum", ["gateway", "status"], ProcessOptions(None, Map(), None)).stdout
  val a = o.split("port:")
  if a.length < 2 then "8080" else firstLine(a(1) + "")

def mpStatusLine(room: String): String =
  val pids = exec("pgrep", ["-f", s"meetings participant.*--room $room"], ProcessOptions(None, Map(), None)).stdout
  if pids.trim == "" then ""
  else exec("ps", ["-o", "command=", "-p", firstLine(pids + "")], ProcessOptions(None, Map(), None)).stdout

def mpModelOf(line: String): String =
  val a = line.split("--model ")
  if a.length < 2 then "" else firstWord(a(1) + "")

def mpOption(l: String): View =
  element("option", ["value" -> (modelSpec(l) + "")], Map(), [textNode(modelSpec(l) + "")])

def policyOption(p: String): View =
  element("option", ["value" -> p], Map(), [textNode(p)])

def mpPage(room: String): String =
  val sl      = mpStatusLine(room)
  val running = sl.trim != ""
  val mo      = exec("rozum", ["models", "list"], ProcessOptions(None, Map(), None)).stdout
  val ml      = mo.split("\n").filter(l => l.contains(":")).toList
  val mopts   = ml.map(mpOption).toList
  val popts   = ["mention", "always", "manual"].map(policyOption).toList
  val statusV = if running then
      element("div", ["style" -> "margin:8px 0 14px"], Map(), [
        element("span", Map(), Map(), [textNode("● запущена: ")]),
        element("code", ["style" -> "font-family:ui-monospace,Menlo,monospace; font-size:0.9em; background:#23272e; padding:1px 6px; border-radius:5px; color:#6ee7a8"], Map(), [textNode(mpModelOf(firstLine(sl + "")))]),
        element("form", ["method" -> "post", "action" -> "/do", "enctype" -> "text/plain", "style" -> "display:inline; margin-left:10px", "onsubmit" -> "return confirm('Остановить модель-участника?')"], Map(), [
          element("input", ["type" -> "hidden", "name" -> "act", "value" -> "mpstop"], Map(), []),
          element("input", ["type" -> "hidden", "name" -> "room", "value" -> room], Map(), []),
          element("button", ["style" -> "background:#b3431f; color:#fff; border:0; border-radius:6px; padding:4px 12px; font-size:13px"], Map(), [textNode("🛑 стоп")])
        ])
      ])
    else element("div", ["style" -> "color:#5b626d; margin:8px 0 14px"], Map(), [textNode("модель-участник не запущена")])
  val startForm = element("form", ["method" -> "post", "action" -> "/do", "enctype" -> "text/plain", "style" -> "display:flex; flex-direction:column; gap:9px"], Map(), [
    element("input", ["type" -> "hidden", "name" -> "act", "value" -> "mpstart"], Map(), []),
    element("input", ["type" -> "hidden", "name" -> "room", "value" -> room], Map(), []),
    element("label", ["style" -> "font-size:12px; color:#9ad"], Map(), [textNode("модель")]),
    element("select", ["name" -> "model", "style" -> "padding:8px 10px; border-radius:8px; border:1px solid #333a44; background:#0f1115; color:#e6e6e6; font-size:16px"], Map(), mopts),
    element("label", ["style" -> "font-size:12px; color:#9ad"], Map(), [textNode("когда отвечать")]),
    element("select", ["name" -> "policy", "style" -> "padding:8px 10px; border-radius:8px; border:1px solid #333a44; background:#0f1115; color:#e6e6e6; font-size:16px"], Map(), popts),
    element("label", ["style" -> "font-size:12px; color:#9ad"], Map(), [textNode("персона / контекст (кто это, о чём конференция)")]),
    element("input", ["name" -> "persona", "placeholder" -> "напр. ты эксперт по Rust, помогаешь команде…", "autocomplete" -> "off", "style" -> "padding:8px 10px; border-radius:8px; border:1px solid #333a44; background:#0f1115; color:#e6e6e6; font-size:16px"], Map(), []),
    element("button", ["style" -> "margin-top:4px; background:#2e7d4f; color:#fff; border:0; border-radius:8px; padding:9px 14px; font-weight:600"], Map(), [textNode("🤖 запустить модель в комнате")])
  ])
  val back = element("a", ["href" -> ("/r/" + room), "style" -> "color:#7ab8ff; text-decoration:none"], Map(), [textNode("← чат")])
  val doc  = element("div", ["style" -> "padding:max(16px,env(safe-area-inset-top)) max(16px,env(safe-area-inset-right)) 36px max(16px,env(safe-area-inset-left)); color:#e6e6e6; font:15px/1.5 -apple-system,system-ui,sans-serif; max-width:680px; margin:0 auto"], Map(), [
    back,
    element("h2", ["style" -> "margin:8px 0 2px"], Map(), [textNode("Модель-участник")]),
    element("div", ["style" -> "font-size:13px; color:#6b7280; margin-bottom:8px"], Map(), [textNode("комната: " + room)]),
    statusV,
    startForm
  ])
  head ++ renderHtml(doc)

def managePage(): String =
  val rlines    = statusOut().split("\n").filter(l => l.contains("project:")).toList
  val roomList  = element("div", Map(), Map(), rlines.map(roomItem).toList)
  val modelsOut = exec("rozum", ["models", "list"], ProcessOptions(None, Map(), None)).stdout
  val mlines    = modelsOut.split("\n").filter(l => l.contains(":")).toList
  val modelList = element("div", Map(), Map(), mlines.map(modelItem).toList)
  val back  = element("a", ["href" -> "/", "style" -> "color:#7ab8ff; text-decoration:none"], Map(), [textNode("← чат")])
  val title = element("h2", ["style" -> "margin:8px 0 2px"], Map(), [textNode("Управление")])
  val doc = element("div", ["style" -> "padding:max(16px,env(safe-area-inset-top)) max(16px,env(safe-area-inset-right)) 36px max(16px,env(safe-area-inset-left)); color:#e6e6e6; font:15px/1.5 -apple-system,system-ui,sans-serif; max-width:680px; margin:0 auto"], Map(), [
    back, title,
    section("Комнаты", element("div", Map(), Map(), [createForm(), cleanForm(), roomList])),
    section("Модели", modelList),
    section("Гейтвей — модель для агентов", gwView()),
    section("Агенты — активны в rozum", agentsView())
  ])
  head ++ renderHtml(doc)

def hasBad(s: String): Boolean =
  s.contains("'") || s.contains("\"") || s.contains("`") || s.contains("$") || s.contains(";") || s.contains("&") || s.contains("|") || s.contains(" ") || s.contains("/") || s.contains("\\") || s.contains("<") || s.contains(">") || s.contains("(") || s.contains(")")

def doAction(body: String): String =
  val ap = body.split("act=")
  val act = if ap.length < 2 then "" else firstLine(ap(1) + "")
  val np = body.split("name=")
  val name = if np.length < 2 then "" else firstLine(np(1) + "")
  val sp = body.split("spec=")
  val spec = if sp.length < 2 then "" else firstLine(sp(1) + "")
  val rp = body.split("room=")
  val room = if rp.length < 2 then "" else firstLine(rp(1) + "")
  val mp = body.split("model=")
  val model = if mp.length < 2 then "" else firstLine(mp(1) + "")
  val pp = body.split("policy=")
  val policy = if pp.length < 2 then "mention" else firstLine(pp(1) + "")
  val pe = body.split("persona=")
  val persona = if pe.length < 2 then "" else pe(1).trim
  if act == "createroom" && name != "" then
    if hasBad(name) then "<!doctype html><meta http-equiv='refresh' content='0;url=/manage'>ok"
    else
      val cmd = s"ROZUM_MEETING_ROOM=$name rozum meetings post 'комната создана'"
      val r = exec("sh", ["-c", cmd], ProcessOptions(None, Map(), None))
      s"<!doctype html><meta http-equiv='refresh' content='0;url=/r/$name'>ok"
  else if act == "delroom" && name != "" then
    val r = exec("python3", ["-c", delPy, name], ProcessOptions(None, Map(), None))
    "<!doctype html><meta http-equiv='refresh' content='0;url=/manage'>ok"
  else if act == "rmmodel" && spec != "" then
    val r = exec("rozum", ["models", "rm", spec], ProcessOptions(None, Map(), None))
    "<!doctype html><meta http-equiv=\"refresh\" content=\"0;url=/manage\">ok"
  else if act == "cleanempty" then
    val r = exec("python3", ["-c", cleanPy], ProcessOptions(None, Map(), None))
    "<!doctype html><meta http-equiv='refresh' content='0;url=/manage'>ok"
  else if act == "gwswitch" && spec != "" then
    val r = exec("rozum", ["gateway", "switch", "--model", spec], ProcessOptions(None, Map(), None))
    "<!doctype html><meta http-equiv=\"refresh\" content=\"0;url=/manage\">ok"
  else if act == "gwstop" then
    val r = exec("rozum", ["gateway", "stop"], ProcessOptions(None, Map(), None))
    "<!doctype html><meta http-equiv=\"refresh\" content=\"0;url=/manage\">ok"
  else if act == "gwunload" then
    val r = exec("rozum", ["gateway", "unload"], ProcessOptions(None, Map(), None))
    "<!doctype html><meta http-equiv=\"refresh\" content=\"0;url=/manage\">ok"
  else if act == "mpstart" && room != "" && model != "" then
    val url = s"http://127.0.0.1:${gwPort()}/v1"
    if persona == "" then
      val r = exec("sh", ["-c", "nohup \"$@\" >/tmp/rozum-mp.log 2>&1 &", "x", "rozum", "meetings", "participant", "--model", model, "--room", room + "", "--reply-policy", policy, "--gateway-url", url], ProcessOptions(None, Map(), None))
      s"<!doctype html><meta http-equiv='refresh' content='1;url=/mp/$room'>ok"
    else
      val r = exec("sh", ["-c", "nohup \"$@\" >/tmp/rozum-mp.log 2>&1 &", "x", "rozum", "meetings", "participant", "--model", model, "--room", room + "", "--reply-policy", policy, "--gateway-url", url, "--persona", persona], ProcessOptions(None, Map(), None))
      s"<!doctype html><meta http-equiv='refresh' content='1;url=/mp/$room'>ok"
  else if act == "mpstop" && room != "" then
    val r = exec("pkill", ["-f", s"meetings participant.*--room ${room + ""}"], ProcessOptions(None, Map(), None))
    s"<!doctype html><meta http-equiv='refresh' content='0;url=/mp/$room'>ok"
  else "<!doctype html><meta http-equiv=\"refresh\" content=\"0;url=/manage\">ok"

@main def run(): Unit =
  route("GET",  "/r/", req => page(afterPrefix(req)))
  route("GET",  "/m/", req => roomMsgs(afterPrefix(req)))
  route("GET",  "/mp/", req => mpPage(afterPrefix(req)))
  route("POST", "/p",  req => doPost(req))
  route("POST", "/do", req => doAction(req))
  route("GET",  "/manage", req => managePage())
  route("GET",  "/manifest.webmanifest", req => manifest())
  route("GET",  "/sw.js",   req => serviceWorkerJs())
  route("GET",  "/icon.svg", req => iconSvgDoc())
  route("GET",  "/", req => page("demo"))
  serve(8405)
```
